---
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const logos = [
  ["chatgpt", "ChatGPT", "company-logo--chatgpt"],
  ["apple", "Apple", ""],
  ["googlecloud", "Google Cloud", ""],
  ["google", "Google", ""],
  ["cloudflare", "Cloudflare", ""],
  ["meta", "Meta", ""],
  ["nvidia", "Nvidia", ""],
  ["broadcom", "Broadcom", ""],
  ["github", "GitHub", ""],
  ["tesla", "Tesla", ""],
  ["samsung", "Samsung", ""],
  ["gitlab", "GitLab", ""],
  ["bitbucket", "Bitbucket", ""],
  ["jira", "Jira", ""],
  ["linear", "Linear", ""],
  ["cisco", "Cisco", ""],
  ["figma", "Figma", ""],
  ["intel", "Intel", ""],
  ["qualcomm", "Qualcomm", ""],
  ["amd", "AMD", ""],
  ["notion", "Notion", ""],
  ["palantir", "Palantir", ""],
  ["netflix", "Netflix", ""],
  ["uber", "Uber", ""],
  ["spotify", "Spotify", ""],
  ["airbnb", "Airbnb", ""],
  ["shopify", "Shopify", ""],
  ["sap", "SAP", ""],
  ["sony", "Sony", ""],
  ["xiaomi", "Xiaomi", ""],
  ["dropbox", "Dropbox", ""],
  ["baidu", "Baidu", ""],
  ["tiktok", "TikTok", ""],
  ["dell", "Dell", ""],
  ["discord", "Discord", ""],
  ["hp", "HP", ""],
  ["ericsson", "Ericsson", ""],
  ["nokia", "Nokia", ""],
  ["atlassian", "Atlassian", ""],
  ["zoom", "Zoom", ""],
] as const;
---

<div class="company-scroller" id="company-scroller" aria-label="A moving rail of technology company logos">
  <div class="company-scroller-viewport">
    <div class="company-scroller-track" id="company-scroller-track">
      {logos.map(([name, alt, className]) => (
        <span class:list={["company-logo", className]}>
          <img src={`${base}assets/company-logos/${name}.svg`} alt={alt} loading="lazy" decoding="async" />
        </span>
      ))}
      {logos.map(([name, , className]) => (
        <span class:list={["company-logo", className]} aria-hidden="true">
          <img src={`${base}assets/company-logos/${name}.svg`} alt="" loading="lazy" decoding="async" />
        </span>
      ))}
    </div>
  </div>
</div>
