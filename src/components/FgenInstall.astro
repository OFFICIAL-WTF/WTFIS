---
import { fgenInstall, fgenReleases } from "../data/fgen-install";
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const gallery = [
  { image: 1, x: "4%", y: "70%", size: "20%", mobileX: "-8%", mobileY: "70%", mobileSize: "48%", tilt: -7, distance: 1.75, depth: 1 },
  { image: 2, x: "76%", y: "76%", size: "26%", mobileX: "61%", mobileY: "76%", mobileSize: "55%", tilt: 6, distance: 1.95, depth: 2 },
  { image: 5, x: "-9%", y: "160%", size: "33%", mobileX: "-20%", mobileY: "156%", mobileSize: "68%", tilt: -5, distance: 2.4, depth: 3 },
  { image: 4, x: "68%", y: "180%", size: "22%", mobileX: "61%", mobileY: "190%", mobileSize: "48%", tilt: 7, distance: 1.75, depth: 1 },
  { image: 3, x: "10%", y: "196%", size: "27%", mobileX: "-6%", mobileY: "203%", mobileSize: "57%", tilt: -6, distance: 1.95, depth: 2 },
  { image: 6, x: "52%", y: "245%", size: "36%", mobileX: "38%", mobileY: "257%", mobileSize: "70%", tilt: 5, distance: 2.4, depth: 3 },
];
---

<section class="image-flight" id="image-flight" aria-label="Generated image gallery and FGEN installation">
  <div class="flight-runway">
    <div class="flight-frame">
      <div class="flight-gallery" aria-hidden="true">
        {gallery.map((card) => (
          <div class="flight-card" data-flight-distance={card.distance} style={`--x:${card.x};--y:${card.y};--size:${card.size};--mobile-x:${card.mobileX};--mobile-y:${card.mobileY};--mobile-size:${card.mobileSize};--tilt:${card.tilt}deg;--depth:${card.depth}`}>
            <figure class="flight-art">
              <img src={`${base}assets/fgen/float-0${card.image}.webp`} alt="" width="800" height="800" decoding="async" />
            </figure>
          </div>
        ))}
      </div>
    </div>
  </div>
    <div class="flight-install" id="install" data-nav-light>
      <div class="install-layer-inner">
        <div class="install-copy">
          <h2 class="install-heading" id="install-heading">FGEN</h2>
          <nav class="install-next" aria-label="FGEN resources">
            <a href={fgenReleases} target="_blank" rel="noreferrer">downloads ↗</a>
            <a href={`${base}fgen/docs/#auth`}>codex login →</a>
            <a href={`${base}fgen/docs/`}>docs →</a>
          </nav>
          <span class="copy-status" role="status" aria-live="polite"></span>
        </div>
        <div class="install-shell" id="install-shell" role="tabpanel" aria-labelledby="platform-tab-macos">
          <div class="install-shell-header">
            <span class="terminal-lights" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="terminal-name" data-fgen-terminal-name>TERMINAL / INSTALL</span>
          </div>
          <div class="install-shell-line" data-fgen-shell-line data-active-platform="macos">
            <span class="install-shell-prompt" aria-hidden="true">$</span>
            <code class="fgen-install-command" data-fgen-command tabindex="0">{fgenInstall[0].command.replace(/\n/g, " && ")}</code>
            <button class="copy-button" type="button" data-fgen-copy={fgenInstall[0].command.replace(/\n/g, " && ")} aria-label={`Copy ${fgenInstall[0].label} install command`}>copy</button>
          </div>
          <noscript>
            <div class="fgen-nojs-commands" aria-label="Install commands">
              {fgenInstall.map((platform) => (
                <p>
                  <strong>{platform.label}</strong>
                  <code>{platform.id === "macos" ? platform.command.replace(/\n/g, " && ") : platform.command}</code>
                </p>
              ))}
            </div>
          </noscript>
        </div>
        <div class="install-platforms" id="install-platforms" role="tablist" aria-label="Supported platforms">
          {fgenInstall.map((platform, index) => (
            <span>
              <button
                class="platform-control"
                type="button"
                role="tab"
                id={`platform-tab-${platform.id}`}
                aria-controls="install-shell"
                aria-selected={index === 0 ? "true" : "false"}
                tabindex={index === 0 ? 0 : -1}
                aria-label={`Select ${platform.label} install command`}
                title={platform.label}
                data-fgen-platform={platform.id}
                data-fgen-label={platform.label}
                data-fgen-command={platform.id === "macos" ? platform.command.replace(/\n/g, " && ") : platform.command}
                data-fgen-terminal={platform.id === "windows" ? "POWERSHELL / INSTALL" : "TERMINAL / INSTALL"}
              >
                {platform.id === "source" ? <code class="platform-icon platform-icon--source" aria-hidden="true">&lt;/&gt;</code> : <i class="platform-icon" style={`mask-image: url("${base}${platform.icon}")`} aria-hidden="true"></i>}
                <b class="platform-label">{platform.label}</b>
              </button>
            </span>
          ))}
        </div>
      </div>
    </div>
</section>

<style>
  .image-flight { position: relative; z-index: 2; overflow-x: clip; }
  .flight-runway { position: relative; }
  .flight-frame { position: relative; }
  .flight-gallery { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1rem, 1.8vw, 1.5rem); width: min(calc(100% - 4 * var(--edge)), 78rem); margin: 0 auto; padding: 4rem 0; isolation: isolate; }
  .flight-card { min-width: 0; }
  .flight-art { margin: 0; transform: rotate(var(--tilt)); }
  .flight-art img { display: block; width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; border: 3px solid var(--white); box-shadow: 0.6rem 0.7rem 0 rgba(11, 40, 182, 0.7); }
  .flight-install { position: relative; z-index: 1; padding: clamp(2.5rem, 5vw, 5rem) var(--edge) clamp(2rem, 4vw, 4rem); scroll-margin-top: 6rem; border: 2px solid var(--electric-blue-deep); border-bottom: 0; border-radius: clamp(2rem, 5vw, 4rem) clamp(2rem, 5vw, 4rem) 0 0; background: #fff; color: var(--ink); box-shadow: 0 -1rem 3rem rgba(11, 29, 130, 0.18); pointer-events: auto; }
  .install-layer-inner { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); grid-template-areas: "copy shell" "platforms platforms"; align-items: center; gap: clamp(1.5rem, 3vw, 2.5rem); width: min(100%, 82rem); min-height: 0; padding: 0; }
  .install-heading { font-size: clamp(5rem, 10vw, 9.5rem); }
  .install-next { display: flex; flex-wrap: wrap; gap: 1.25rem; margin-top: 1rem; }
  .install-next a { color: var(--ink); font-size: clamp(0.65rem, 0.9vw, 0.8rem); padding-block: 0.5rem; text-decoration: none; }
  .install-next a:hover { text-decoration: underline; }
  .install-next a:focus-visible { outline: 2px solid var(--electric-blue); outline-offset: 4px; }
  .install-shell { width: 100%; border-color: var(--electric-blue-deep); box-shadow: 0.5rem 0.55rem 0 #dbe3ff; }
  .install-shell-header { min-height: 3.5rem; padding: 0.9rem 1.25rem; }
  .install-shell-header .terminal-name { font-size: 0.68rem; }
  .install-shell-line { min-height: 7rem; gap: 0.9rem; padding: 1.35rem; }
  .install-shell .fgen-install-command { font-size: clamp(0.78rem, 1vw, 1rem); }
  .copy-button { min-height: 2.75rem; padding: 0.7rem 1.1rem; font-size: 0.68rem; }
  .install-platforms { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); align-items: stretch; gap: 0.75rem; margin-top: 0; padding-top: 1.5rem; border-color: rgba(16, 39, 133, 0.2); }
  .install-platforms > span { width: auto; height: auto; }
  .copy-status { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .install-platforms .platform-control {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    width: 100%;
    min-height: 3.5rem;
    border: 1px solid var(--electric-blue-deep);
    border-radius: 0.8rem;
    padding: 0.7rem 1rem;
    background: #0b1d82;
    color: var(--white);
    cursor: pointer;
  }
  .install-platforms .platform-control:hover { color: var(--acid); }
  .install-platforms .platform-control[aria-selected="true"] { background: var(--acid); color: var(--ink); border-color: var(--acid); }
  .install-platforms .platform-icon { flex: 0 0 auto; width: 1.6rem; height: 1.6rem; color: inherit; transform: none; }
  .platform-label { font-size: clamp(0.65rem, 0.9vw, 0.8rem); font-weight: 500; }
  .platform-icon--source { display: grid; place-items: center; font-size: 1.1rem; font-weight: 600; }
  i.platform-icon { background: currentColor; mask-repeat: no-repeat; mask-position: center; mask-size: contain; }
  .install-platforms .platform-control:focus-visible {
    outline: 2px solid var(--electric-blue);
    outline-offset: 4px;
  }
  .fgen-install-command {
    min-width: 0;
    overflow-wrap: anywhere;
    white-space: pre-wrap;
  }
  .install-shell-line[data-active-platform="windows"] { align-items: start; }
  .install-shell-line[data-active-platform="windows"] .fgen-install-command {
    max-height: min(34svh, 24rem);
    overflow: auto;
    overflow-wrap: normal;
    white-space: pre;
  }
  .fgen-nojs-commands {
    border-top: 1px solid rgba(251, 251, 247, 0.16);
    padding: 0.8rem 1rem 1rem;
  }
  .fgen-nojs-commands p {
    display: grid;
    gap: 0.25rem;
    margin: 0.75rem 0 0;
  }
  .fgen-nojs-commands strong {
    color: var(--acid);
    font-size: 0.62rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }
  .fgen-nojs-commands code {
    color: var(--white);
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.68rem;
    line-height: 1.45;
    overflow-wrap: anywhere;
    white-space: pre-wrap;
  }
  .image-flight.is-animated {
    margin-top: calc(-1 * var(--flight-overlap, 0px));
    pointer-events: none;
  }
  .is-animated .flight-runway { height: 320svh; }
  .is-animated .flight-frame { position: sticky; top: 0; height: 100svh; overflow: hidden; }
  .is-animated .flight-gallery { position: absolute; inset: 0; display: block; width: 100%; height: 100%; margin: 0; padding: 0; }
  .is-animated .flight-card { position: absolute; z-index: var(--depth); left: var(--x); top: var(--y); width: var(--size); max-width: 36rem; }
  .is-animated .flight-install { margin-top: -30svh; }
  @media (max-width: 760px) {
    .flight-install { padding: 2rem 1.25rem 1.5rem; }
    .install-layer-inner { grid-template-columns: minmax(0, 1fr); grid-template-areas: "copy" "shell" "platforms"; gap: 1.25rem; }
    .install-heading { font-size: clamp(4rem, 20vw, 7rem); }
    .install-next { justify-content: center; gap: 1rem; margin-top: 0.5rem; }
    .install-shell-header { padding: 0.75rem 1rem; }
    .install-shell-line { min-height: 0; padding: 1rem; }
    .install-platforms { grid-template-columns: repeat(2, minmax(0, 1fr)); padding-top: 1rem; }
    .install-platforms .platform-control { padding: 0.65rem; }
    .flight-gallery { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
    .is-animated .flight-runway { height: 280svh; }
    .is-animated .flight-card { left: var(--mobile-x); top: var(--mobile-y); width: var(--mobile-size); }
    .is-animated .flight-install { margin-top: -25svh; }
  }
  @media (max-height: 650px) and (min-width: 761px) {
    .install-shell-line[data-active-platform="windows"] .fgen-install-command { max-height: 31svh; }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const installer = document.querySelector<HTMLElement>("#install");
  if (installer) {
    const tabs = [...installer.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panel = installer.querySelector<HTMLElement>('[role="tabpanel"]')!;
    const command = installer.querySelector<HTMLElement>(".fgen-install-command")!;
    const copy = installer.querySelector<HTMLButtonElement>("[data-fgen-copy]")!;
    const shellLine = installer.querySelector<HTMLElement>("[data-fgen-shell-line]")!;
    const terminalName = installer.querySelector<HTMLElement>("[data-fgen-terminal-name]")!;
    const select = (index: number, focus = false) => {
      tabs.forEach((tab, i) => {
        tab.setAttribute("aria-selected", String(i === index));
        tab.tabIndex = i === index ? 0 : -1;
      });
      const tab = tabs[index];
      command.textContent = tab.dataset.fgenCommand!;
      command.scrollTop = command.scrollLeft = 0;
      copy.dataset.fgenCopy = tab.dataset.fgenCommand;
      copy.setAttribute("aria-label", `Copy ${tab.dataset.fgenLabel} install command`);
      copy.textContent = "copy";
      panel.setAttribute("aria-labelledby", tab.id);
      shellLine.dataset.activePlatform = tab.dataset.fgenPlatform;
      terminalName.textContent = tab.dataset.fgenTerminal!;
      if (focus) tab.focus();
    };
    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => select(index));
      tab.addEventListener("keydown", (event) => {
        let next = index;
        if (event.key === "ArrowRight") next = (index + 1) % tabs.length;
        else if (event.key === "ArrowLeft") next = (index + tabs.length - 1) % tabs.length;
        else if (event.key === "Home") next = 0;
        else if (event.key === "End") next = tabs.length - 1;
        else return;
        event.preventDefault();
        select(next, true);
      });
    });
    select(0);
    installer.querySelectorAll<HTMLButtonElement>("[data-fgen-copy]").forEach((button) => {
      button.addEventListener("click", async () => {
        const status = installer.querySelector<HTMLElement>(".copy-status");
        try {
          await navigator.clipboard.writeText(button.dataset.fgenCopy ?? "");
          button.textContent = "copied";
          if (status) status.textContent = "Install command copied.";
        } catch {
          const code = installer.querySelector(".fgen-install-command");
          if (code) {
            const range = document.createRange();
            range.selectNodeContents(code);
            window.getSelection()?.removeAllRanges();
            window.getSelection()?.addRange(range);
          }
          button.textContent = "selected";
          if (status) status.textContent = "Command selected. Copy with your keyboard.";
        }
        window.setTimeout(() => { button.textContent = "copy"; }, 1800);
      });
    });
  }

  const flight = document.querySelector<HTMLElement>(".image-flight");
  if (flight) {
    const media = gsap.matchMedia();
    media.add("(prefers-reduced-motion: no-preference)", () => {
      flight.classList.add("is-animated");
      const runway = flight.querySelector<HTMLElement>(".flight-runway")!;
      const frame = flight.querySelector<HTMLElement>(".flight-frame")!;
      const output = document.querySelector<HTMLElement>("[data-route-output]");
      const alignFlight = () => {
        if (!output) return;
        const naturalTop = flight.getBoundingClientRect().top - parseFloat(getComputedStyle(flight).marginTop);
        const outputBox = output.getBoundingClientRect();
        const overlap = Math.max(0, naturalTop - outputBox.top - outputBox.height * 0.58);
        flight.style.setProperty("--flight-overlap", `${overlap}px`);
      };
      alignFlight();
      ScrollTrigger.addEventListener("refreshInit", alignFlight);
      const timeline = gsap.timeline({
        defaults: { ease: "none" },
        scrollTrigger: { id: "fgen-image-flight", trigger: runway, start: "top bottom", end: "bottom bottom", scrub: 0.45, invalidateOnRefresh: true },
      });
      flight.querySelectorAll<HTMLElement>(".flight-card").forEach((card) => {
        timeline.fromTo(card, { y: 0 }, {
          y: () => -frame.clientHeight * Number(card.dataset.flightDistance),
          duration: 1,
        }, 0);
      });
      // The white installer rises in normal flow, so its height and the
      // following feature section never depend on the animation's progress.
      const jumpToInstall = () => {
        if (window.location.hash === "#install") installer?.scrollIntoView({ behavior: "instant", block: "start" });
      };
      document.fonts.ready.then(() => {
        ScrollTrigger.refresh();
        jumpToInstall();
      });
      return () => {
        ScrollTrigger.removeEventListener("refreshInit", alignFlight);
        flight.style.removeProperty("--flight-overlap");
        timeline.scrollTrigger?.kill();
        flight.classList.remove("is-animated");
      };
    });
  }
</script>
