---
import { fgenInstall, fgenReleases } from "../data/fgen-install";
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
---

<section class="image-flight" id="image-flight" aria-label="Generated image gallery and FGEN installation">
  <div class="flight-frame">
    <div class="flight-gallery" aria-hidden="true">
      {[13, 64, 34, 53, 19, 47].map((left, index) => (
        <figure class="flight-art" style={`--left:${left}%;--tilt:${[-12, 9, -6, 13, 7, -9][index]}deg`} data-depth={[0.7, 1.1, 0.85, 1.3, 1.05, 0.8][index]}>
          <img src={`${base}assets/fgen/float-0${index + 1}.webp`} alt="" width="800" height="800" decoding="async" />
        </figure>
      ))}
    </div>
    <div class="flight-install install-tray" id="install" data-nav-light>
      <div class="install-layer-inner">
        <div class="install-copy">
          <h2 class="install-heading" id="install-heading">FGEN</h2>
          <nav class="install-next" aria-label="FGEN resources">
            <a href={fgenReleases} target="_blank" rel="noreferrer">downloads ↗</a>
            <a href={`${base}fgen/docs/#auth`}>codex login →</a>
            <a href={`${base}fgen/docs/`}>docs →</a>
          </nav>
          <span class="copy-status" role="status" aria-live="polite"></span>
        </div>
        <div class="install-shell" id="install-shell" role="tabpanel" aria-labelledby="platform-tab-macos">
          <div class="install-shell-header">
            <span class="terminal-lights" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="terminal-name" data-fgen-terminal-name>TERMINAL / INSTALL</span>
          </div>
          <div class="install-shell-line" data-fgen-shell-line data-active-platform="macos">
            <span class="install-shell-prompt" aria-hidden="true">$</span>
            <code class="fgen-install-command" data-fgen-command tabindex="0">{fgenInstall[0].command.replace(/\n/g, " && ")}</code>
            <button class="copy-button" type="button" data-fgen-copy={fgenInstall[0].command.replace(/\n/g, " && ")} aria-label={`Copy ${fgenInstall[0].label} install command`}>copy</button>
          </div>
          <noscript>
            <div class="fgen-nojs-commands" aria-label="Install commands">
              {fgenInstall.map((platform) => (
                <p>
                  <strong>{platform.label}</strong>
                  <code>{platform.id === "macos" ? platform.command.replace(/\n/g, " && ") : platform.command}</code>
                </p>
              ))}
            </div>
          </noscript>
        </div>
        <div class="install-platforms" id="install-platforms" role="tablist" aria-label="Supported platforms">
          {fgenInstall.map((platform, index) => (
            <span>
              <button
                class="platform-control"
                type="button"
                role="tab"
                id={`platform-tab-${platform.id}`}
                aria-controls="install-shell"
                aria-selected={index === 0 ? "true" : "false"}
                tabindex={index === 0 ? 0 : -1}
                aria-label={`Select ${platform.label} install command`}
                title={platform.label}
                data-fgen-platform={platform.id}
                data-fgen-label={platform.label}
                data-fgen-command={platform.id === "macos" ? platform.command.replace(/\n/g, " && ") : platform.command}
                data-fgen-terminal={platform.id === "windows" ? "POWERSHELL / INSTALL" : "TERMINAL / INSTALL"}
              >
                {platform.id === "source" ? <code class="platform-icon platform-icon--source" aria-hidden="true">&lt;/&gt;</code> : <i class="platform-icon" style={`mask-image: url("${base}${platform.icon}")`} aria-hidden="true"></i>}
              </button>
            </span>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .image-flight { position: relative; z-index: 2; overflow-x: clip; }
  .flight-frame { position: relative; }
  .flight-gallery { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1rem, 4vw, 4rem); max-width: 76rem; margin: 0 auto; padding: 6rem var(--edge); }
  .flight-art { margin: 0; transform: rotate(var(--tilt)); }
  .flight-art img { display: block; width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; border: 3px solid var(--white); box-shadow: 0.6rem 0.7rem 0 rgba(11, 40, 182, 0.7); }
  .flight-install { min-height: 85svh; display: grid; place-items: center; padding: 7rem var(--edge) 4rem; scroll-margin-top: 6rem; border: 2px solid var(--electric-blue-deep); border-bottom: 0; border-radius: clamp(2rem, 7vw, 6rem) clamp(2rem, 7vw, 6rem) 0 0; box-shadow: 0 -1rem 3rem rgba(11, 29, 130, 0.18); }
  .install-layer-inner { grid-template-areas: "copy shell" "platforms platforms"; min-height: 0; }
  .install-next { display: flex; flex-wrap: wrap; gap: 1.5rem; margin-top: 1.2rem; }
  .install-next a { color: var(--ink); font-size: 0.7rem; padding-block: 0.5rem; text-decoration: none; }
  .install-next a:hover { text-decoration: underline; }
  .copy-status { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .install-platforms .platform-control {
    display: grid;
    width: 100%;
    height: 100%;
    place-items: center;
    border: 0;
    padding: 0;
    background: transparent;
    color: var(--electric-blue);
    cursor: pointer;
  }
  .install-platforms .platform-control:hover { color: var(--electric-blue-deep); }
  .install-platforms .platform-control[aria-selected="true"] { box-shadow: 0 2px 0 var(--electric-blue); }
  .platform-icon--source { display: grid; place-items: center; font-size: 1.1rem; font-weight: 600; }
  i.platform-icon { background: currentColor; mask-repeat: no-repeat; mask-position: center; mask-size: contain; }
  .install-platforms .platform-control:focus-visible {
    border-radius: 0.35rem;
    outline: 2px solid var(--electric-blue);
    outline-offset: 4px;
  }
  .fgen-install-command {
    min-width: 0;
    overflow-wrap: anywhere;
    white-space: pre-wrap;
  }
  .install-shell-line[data-active-platform="windows"] { align-items: start; }
  .install-shell-line[data-active-platform="windows"] .fgen-install-command {
    max-height: min(34svh, 24rem);
    overflow: auto;
    overflow-wrap: normal;
    white-space: pre;
  }
  .fgen-nojs-commands {
    border-top: 1px solid rgba(251, 251, 247, 0.16);
    padding: 0.8rem 1rem 1rem;
  }
  .fgen-nojs-commands p {
    display: grid;
    gap: 0.25rem;
    margin: 0.75rem 0 0;
  }
  .fgen-nojs-commands strong {
    color: var(--acid);
    font-size: 0.62rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }
  .fgen-nojs-commands code {
    color: var(--white);
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.68rem;
    line-height: 1.45;
    overflow-wrap: anywhere;
    white-space: pre-wrap;
  }
  .image-flight.is-animated {
    height: 560svh;
    margin-top: calc(-1 * var(--flight-overlap, 0px));
    pointer-events: none;
  }
  .is-animated .flight-frame { position: sticky; top: 0; height: 100svh; overflow: hidden; }
  .is-animated .flight-gallery { position: absolute; inset: 0; display: block; max-width: none; padding: 0; }
  .is-animated .flight-art { position: absolute; top: 0; left: var(--left); width: clamp(12rem, 27vw, 24rem); }
  .is-animated .flight-art:nth-child(2n) { width: clamp(10rem, 23vw, 20rem); }
  .is-animated .flight-install { position: absolute; inset: 0; min-height: 0; padding-block: 6.5rem 2rem; }
  @media (max-width: 760px) {
    .flight-install { min-height: 100svh; padding: 6rem 1.25rem 3rem; }
    .install-layer-inner { grid-template-areas: "copy" "shell" "platforms"; }
    .install-next { gap: 1rem; margin-top: 0.8rem; }
    .flight-gallery { grid-template-columns: repeat(2, 1fr); gap: 1.5rem; }
    .is-animated .flight-art { width: 45vw; left: calc(var(--left) * 0.8); }
    .is-animated .flight-art:nth-child(2n) { width: 42vw; }
    .is-animated .flight-art:first-child { left: 5%; }
    .is-animated .flight-art:nth-child(2) { left: 54%; }
  }
  @media (max-height: 650px) and (min-width: 761px) {
    .install-shell-line[data-active-platform="windows"] .fgen-install-command { max-height: 31svh; }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const installer = document.querySelector<HTMLElement>("#install");
  if (installer) {
    const tabs = [...installer.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panel = installer.querySelector<HTMLElement>('[role="tabpanel"]')!;
    const command = installer.querySelector<HTMLElement>(".fgen-install-command")!;
    const copy = installer.querySelector<HTMLButtonElement>("[data-fgen-copy]")!;
    const shellLine = installer.querySelector<HTMLElement>("[data-fgen-shell-line]")!;
    const terminalName = installer.querySelector<HTMLElement>("[data-fgen-terminal-name]")!;
    const select = (index: number, focus = false) => {
      tabs.forEach((tab, i) => {
        tab.setAttribute("aria-selected", String(i === index));
        tab.tabIndex = i === index ? 0 : -1;
      });
      const tab = tabs[index];
      command.textContent = tab.dataset.fgenCommand!;
      command.scrollTop = command.scrollLeft = 0;
      copy.dataset.fgenCopy = tab.dataset.fgenCommand;
      copy.setAttribute("aria-label", `Copy ${tab.dataset.fgenLabel} install command`);
      copy.textContent = "copy";
      panel.setAttribute("aria-labelledby", tab.id);
      shellLine.dataset.activePlatform = tab.dataset.fgenPlatform;
      terminalName.textContent = tab.dataset.fgenTerminal!;
      if (focus) tab.focus();
    };
    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => select(index));
      tab.addEventListener("keydown", (event) => {
        let next = index;
        if (event.key === "ArrowRight") next = (index + 1) % tabs.length;
        else if (event.key === "ArrowLeft") next = (index + tabs.length - 1) % tabs.length;
        else if (event.key === "Home") next = 0;
        else if (event.key === "End") next = tabs.length - 1;
        else return;
        event.preventDefault();
        select(next, true);
      });
    });
    select(0);
    installer.querySelectorAll<HTMLButtonElement>("[data-fgen-copy]").forEach((button) => {
      button.addEventListener("click", async () => {
        const status = installer.querySelector<HTMLElement>(".copy-status");
        try {
          await navigator.clipboard.writeText(button.dataset.fgenCopy ?? "");
          button.textContent = "copied";
          if (status) status.textContent = "Install command copied.";
        } catch {
          const code = installer.querySelector(".fgen-install-command");
          if (code) {
            const range = document.createRange();
            range.selectNodeContents(code);
            window.getSelection()?.removeAllRanges();
            window.getSelection()?.addRange(range);
          }
          button.textContent = "selected";
          if (status) status.textContent = "Command selected. Copy with your keyboard.";
        }
        window.setTimeout(() => { button.textContent = "copy"; }, 1800);
      });
    });
  }

  const flight = document.querySelector<HTMLElement>(".image-flight");
  if (flight) {
    const media = gsap.matchMedia();
    media.add("(prefers-reduced-motion: no-preference)", () => {
      flight.classList.add("is-animated");
      const output = document.querySelector<HTMLElement>("[data-route-output]");
      const alignFlight = () => {
        if (!output) return;
        const naturalTop = flight.getBoundingClientRect().top - parseFloat(getComputedStyle(flight).marginTop);
        flight.style.setProperty("--flight-overlap", `${naturalTop - output.getBoundingClientRect().top}px`);
      };
      alignFlight();
      ScrollTrigger.addEventListener("refreshInit", alignFlight);
      const art = [...flight.querySelectorAll<HTMLElement>(".flight-art")];
      const clusterHeights = [0.13, 0.3, 0.42, 0.15, 0.62, 0.58];
      const timeline = gsap.timeline({
        defaults: { ease: "none" },
        scrollTrigger: { id: "fgen-image-flight", trigger: flight, start: "top bottom", end: "bottom bottom", scrub: 0.65, invalidateOnRefresh: true },
      });
      art.forEach((image, index) => {
        const depth = Number(image.dataset.depth);
        const tilt = parseFloat(image.style.getPropertyValue("--tilt"));
        timeline.fromTo(image,
          { y: () => window.innerHeight * (index < 2 ? 0.7 : 1.05 + index * 0.025), rotation: tilt },
          { y: () => window.innerHeight * clusterHeights[index], rotation: tilt, duration: 1.6 },
          index < 2 ? index * 0.1 : 0.6 + (index - 2) * 0.08,
        );
        timeline.to(image, {
          y: () => window.innerHeight * (clusterHeights[index] - 0.28 * depth),
          rotation: tilt + (index % 2 ? -6 : 6),
          duration: 3.3,
        }, 2.6);
      });
      timeline.fromTo(flight.querySelector(".flight-install"), { yPercent: 105 }, { yPercent: 0, duration: 1.8 }, 5.4);
      timeline.to({}, { duration: 0.45 });
      const revealInstall = (event: Event) => {
        const link = (event.target as Element).closest<HTMLAnchorElement>('a[href$="#install"]');
        if (!link || !timeline.scrollTrigger) return;
        const target = new URL(link.href);
        if (target.pathname !== window.location.pathname) return;
        event.preventDefault();
        const end = timeline.scrollTrigger.end;
        window.scrollTo({ top: end, behavior: "instant" });
        history.replaceState(null, "", "#install");
      };
      document.addEventListener("click", revealInstall);
      const jumpToInstall = () => {
        ScrollTrigger.refresh();
        if (window.location.hash === "#install" && timeline.scrollTrigger) window.scrollTo(0, timeline.scrollTrigger.end);
      };
      document.fonts.ready.then(jumpToInstall);
      return () => {
        ScrollTrigger.removeEventListener("refreshInit", alignFlight);
        flight.style.removeProperty("--flight-overlap");
        document.removeEventListener("click", revealInstall);
        flight.classList.remove("is-animated");
      };
    });
  }
</script>
