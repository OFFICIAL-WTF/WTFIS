---
import SiteLayout from "../../layouts/SiteLayout.astro";
import CompanyScroller from "../../components/CompanyScroller.astro";
import HeroNotifications from "../../components/HeroNotifications.astro";
import FgenRoutes from "../../components/FgenRoutes.astro";
import FgenInstall from "../../components/FgenInstall.astro";
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const features = [
  { title: "FGEN TUI", command: "fgen -t", href: "tui" },
  { title: "--images", command: 'fgen gen "edit this" --images reference.png', href: "references" },
  { title: "--concurrency", command: 'fgen gen "one" "two" --concurrency 2', href: "batch" },
  { title: "/history", command: "fgen last -n 5", href: "history" },
];
---

<SiteLayout title="FGEN / No Need For Humans To Generate" product="fgen">
  <main>
  <section class="hero fgen-hero" id="pain-point" aria-labelledby="fgen-title">
    <div class="hero-shell">
      <HeroNotifications />
      <div class="title-stage">
        <h1 class="title-lockup" id="fgen-title" aria-label="No Need For Humans To Generate">
          <span class="title-row">
            <span class="word"><span class="word-text">No</span></span>
            <span class="word"><span class="word-text">Need</span></span>
            <span class="media-card media-card--image media-card--wide">
              <span class="media-card__surface"><img class="hero-media-image" src={`${base}assets/fgen/hero-generated.webp`} alt="" width="1024" height="1024" fetchpriority="high" /></span>
            </span>
          </span>
          <span class="title-row">
            <span class="word"><span class="word-text">For</span></span>
            <span class="media-card media-card--image media-card--people">
              <span class="media-card__surface human-surface"><img class="hero-media-image" src={`${base}assets/fgen/human-cutout.png`} alt="" width="1024" height="1024" /></span>
            </span>
            <span class="word"><span class="word-text">Humans</span></span>
          </span>
          <span class="title-row">
            <span class="word"><span class="word-text">To</span></span>
            <span class="media-card media-card--image media-card--people">
              <span class="media-card__surface chatgpt-surface"><img class="hero-media-image" src={`${base}assets/fgen/chatgpt.svg`} alt="" width="100" height="100" /></span>
            </span>
            <span class="word"><span class="word-text">Generate</span></span>
          </span>
        </h1>
        <CompanyScroller />
      </div>
    </div>
  </section>

  <section class="fgen-quote" aria-label="Satirical OpenAI prompt">
    <div class="quote-stage">
      <div class="quote-shell terminal-panel">
        <img class="quote-sticker quote-sticker--top" src={`${base}assets/fgen/sam-altman-sticker.png`} alt="Satirical Sam Altman portrait" width="512" height="512" loading="lazy" />
        <div class="terminal-header">
          <span class="terminal-lights" aria-hidden="true"><i></i><i></i><i></i></span>
        </div>
        <blockquote>
          <span class="quote-prompt" aria-hidden="true">&gt;</span>
          <p>
            <span class="quote-word">“Lets</span>{" "}
            <span class="quote-word">Not</span>{" "}
            <span class="quote-word">Include</span>{" "}
            <span class="quote-word quote-highlight">GPT</span>{" "}
            <span class="quote-word quote-highlight">Image</span>{" "}
            <span class="quote-word quote-highlight">2.5</span>{" "}
            <span class="quote-word">by</span>{" "}
            <span class="quote-word">default</span>{" "}
            <span class="quote-word">in</span>{" "}
            <span class="quote-word quote-oauth">Oauth”</span><span class="quote-caret" aria-hidden="true"></span>
          </p>
        </blockquote>
        <div class="quote-signature">
          <img class="quote-openai" src={`${base}assets/fgen/chatgpt.svg`} alt="OpenAI" width="48" height="48" />
        </div>
      </div>
    </div>
  </section>

  <FgenRoutes />
  <FgenInstall />

  <section class="fgen-features" aria-label="Additional FGEN features">
    <div class="fgen-features-inner">
      <div class="cta-gallery" id="fgen-features">
        <div class="cta-stack-inner scroll-stack-inner">
          {features.map((feature) => (
            <figure class="cta-card scroll-stack-card">
              <div class="cta-shot fgen-blank-shot" aria-hidden="true"></div>
              <figcaption>
                <strong>{feature.title}</strong>
                <code>{feature.command}</code>
                <a href={`${base}fgen/docs/#${feature.href}`}>docs ↗</a>
              </figcaption>
            </figure>
          ))}
          <div class="scroll-stack-end" aria-hidden="true"></div>
        </div>
      </div>
    </div>
  </section>

  <section class="fgen-other-project" aria-label="WTFIS project">
    <div class="other-project-inner">
      <a class="other-project-image" href={`${base}wtfis/`} aria-label="Explore WTFIS">
        <img src={`${base}WTFIS%20logo%20main.png`} alt="" width="1024" height="1024" loading="lazy" />
      </a>
      <div class="install-copy">
        <h2 class="install-heading">WTFIS</h2>
        <a class="menu-pill menu-cta" href={`${base}wtfis/`}>try &gt;WTFIS ↗</a>
      </div>
    </div>
  </section>
  </main>
</SiteLayout>

<style>
  .fgen-hero { position: relative; min-height: 100svh; }
  .fgen-hero .hero-shell { padding-top: 6rem; }
  .fgen-hero .title-stage { padding-bottom: 9rem; min-height: calc(100svh - 6rem); }
  .fgen-hero .word + .word { margin-left: 0.12em; }
  .fgen-hero .hero-media-image { object-fit: cover; background: transparent; }
  .fgen-hero .human-surface { background: var(--acid); }
  .fgen-hero .human-surface img { object-fit: contain; object-position: center top; }
  .fgen-hero .chatgpt-surface { background: #0e1020; }
  .fgen-hero .chatgpt-surface img { padding: 0.08em; object-fit: contain; filter: brightness(0) invert(1); }
  .fgen-quote { position: relative; z-index: 1; }
  .quote-stage { min-height: 95svh; display: grid; place-items: center; padding: 9rem var(--edge); }
  .quote-shell { position: relative; width: min(100%, 72rem); min-height: 0; overflow: visible; border: 2px solid rgba(251,251,247,0.8); border-radius: 1.2rem; background: #0b1d82; box-shadow: 0.8rem 0.9rem 0 rgba(7,27,145,0.55); }
  .quote-shell .terminal-header { min-height: 3.6rem; padding: 1rem 1.4rem; }
  .quote-sticker { width: clamp(8rem, 15vw, 13rem); height: auto; pointer-events: none; }
  .quote-sticker--top { position: absolute; top: -8rem; left: 1rem; transform: rotate(-12deg); }
  .quote-signature { position: absolute; right: 1.4rem; bottom: 1.2rem; }
  .quote-openai { width: clamp(2rem, 4vw, 3.5rem); height: auto; object-fit: contain; filter: brightness(0) invert(1); }
  .quote-word { display: inline-block; }
  blockquote { margin: 0; padding: clamp(1.5rem, 5vw, 4.5rem); display: flex; align-items: start; gap: clamp(0.8rem, 2vw, 2rem); }
  blockquote p { margin: 0; font-family: "Inter", sans-serif; font-size: clamp(2rem, 5.7vw, 5.8rem); font-weight: 900; letter-spacing: -0.065em; line-height: 1.05; }
  .quote-prompt { color: var(--acid); font-size: clamp(2rem, 5vw, 5rem); line-height: 1; }
  .quote-highlight { color: var(--acid); }
  .quote-oauth { display: inline-block; text-decoration: underline wavy var(--acid) 2px; text-underline-offset: 0.14em; }
  .quote-caret { display: inline-block; height: 0.85em; width: 0.09em; margin-left: 0.1em; background: var(--acid); vertical-align: -0.04em; }
  .fgen-features { position: relative; z-index: 1; padding: 2rem 0 0; }
  .fgen-features-inner { width: min(calc(100% - 2 * var(--edge)), 82rem); margin: 0 auto; }
  .fgen-features .cta-stack-inner { padding-bottom: clamp(3rem, 6vh, 5rem); }
  .fgen-features .scroll-stack-card {
    top: calc(6rem + var(--stack-offset, 0rem));
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: center;
    gap: clamp(1rem, 3vw, 3rem);
    height: auto;
    min-height: 22rem;
    margin-bottom: clamp(1.5rem, 4vh, 3rem);
    padding: clamp(1rem, 2vw, 2rem);
    border: 2px solid rgba(251,251,247,0.85);
    background: #0b1d82;
    box-shadow: 0.55rem 0.65rem 0 rgba(7,27,145,0.58);
    transform: none;
    will-change: auto;
  }
  .fgen-features .fgen-blank-shot { width: 100%; margin: 0; background: var(--white); border-color: var(--white); box-shadow: none; }
  .fgen-blank-shot::before, .fgen-blank-shot::after { display: none; }
  .fgen-features figcaption { gap: 1rem; padding: clamp(0.5rem, 1.5vw, 1.5rem); }
  .fgen-features figcaption code { font-size: clamp(0.75rem, 1vw, 1rem); overflow-wrap: anywhere; }
  .fgen-features figcaption a { justify-self: start; padding: 0.5rem 0; text-underline-offset: 0.3em; }
  .fgen-features figcaption a:focus-visible { outline: 2px solid var(--acid); outline-offset: 4px; }
  .fgen-other-project { position: relative; z-index: 1; padding: 2rem var(--edge) 8rem; }
  .other-project-inner { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 5vw; width: min(100%, 70rem); margin: 0 auto; border-top: 1px solid rgba(251,251,247,0.25); padding-top: 5rem; }
  .other-project-image { display: block; width: min(100%, 26rem); justify-self: center; }
  .other-project-image img { display: block; width: 100%; height: auto; }
  .other-project-image:focus-visible { outline: 2px solid var(--acid); outline-offset: 4px; }
  .fgen-other-project .install-copy { grid-area: auto; gap: 2rem; }
  .fgen-other-project .menu-cta { justify-self: start; }
  :global(.site-layout--fgen .site-nav:not(.is-on-light)) { background: rgba(31,66,243,0.96); }
  :global(.site-layout--fgen .site-footer) { background: transparent; color: var(--white); border-top: 1px solid rgba(251,251,247,0.25); }
  :global(.site-layout--fgen .footer-logo-fallback),
  :global(.site-layout--fgen .footer-top > span),
  :global(.site-layout--fgen .footer-links a) { color: var(--white); }
  :global(.site-layout--fgen .footer-links a:hover) { color: var(--acid); }
  :global(.site-layout--fgen .footer-links a:focus-visible) { outline: 2px solid var(--acid); outline-offset: 4px; }
  @media (max-width: 760px) {
    .fgen-hero .title-stage { padding-bottom: 8rem; }
    .quote-stage { min-height: 80svh; padding: 8rem 1.25rem; }
    .quote-shell { border-radius: 0.8rem; }
    .quote-sticker--top { top: -6rem; left: 0; }
    .quote-signature { right: 1rem; bottom: 0.8rem; }
    blockquote { padding: 1.6rem 1rem 2rem; gap: 0.6rem; }
    blockquote p { font-size: clamp(1.9rem, 7vw, 3.5rem); }
    .quote-prompt { font-size: 2rem; }
    .fgen-features .scroll-stack-card { grid-template-columns: minmax(0, 1fr); grid-template-rows: auto auto; min-height: 0; gap: 1rem; padding: 1rem; }
    .fgen-features figcaption { justify-items: center; padding: 0.5rem 0 0; }
    .fgen-features figcaption a { justify-self: center; }
    .other-project-inner { grid-template-columns: 1fr; gap: 2rem; padding-top: 2rem; }
    .other-project-image { width: min(60%, 16rem); }
    .fgen-other-project .install-copy { justify-items: center; }
    .fgen-other-project .menu-cta { justify-self: center; }
  }
  :global(html:not(.js)) .fgen-features .scroll-stack-card { position: relative; top: auto; }
  @media (prefers-reduced-motion: reduce) {
    .fgen-features .scroll-stack-card { position: relative; top: auto; margin-bottom: 2rem; }
    .fgen-features .cta-stack-inner { padding-bottom: 2rem; }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);
  const media = gsap.matchMedia();
  media.add("(prefers-reduced-motion: no-preference)", () => {
    const hero = document.querySelector<HTMLElement>(".fgen-hero");
    const quote = document.querySelector<HTMLElement>(".fgen-quote");
    const words = [...document.querySelectorAll<HTMLElement>(".fgen-hero .word")];
    const mediaCards = [...document.querySelectorAll<HTMLElement>(".fgen-hero .media-card")];
    const targets = [...words, ...mediaCards];
    const bounds = new Map<HTMLElement, DOMRect>();
    const invalidateBounds = () => bounds.clear();
    const intro = gsap.timeline({ defaults: { ease: "power3.out" }, onComplete: invalidateBounds });
    intro
      .fromTo(".site-nav .menu-pill", { y: -16, opacity: 0 }, { y: 0, opacity: 1, duration: 0.52, stagger: 0.065, clearProps: "transform,opacity" }, 0)
      .fromTo(".fgen-hero .title-row", { y: 82, opacity: 0 }, { y: 0, opacity: 1, duration: 0.78, stagger: 0.14, ease: "power4.out", clearProps: "transform,opacity" }, 0.42)
      .fromTo(".fgen-hero .media-card__surface", { scale: 0.72, rotation: -2.5, opacity: 0 }, { scale: 1, rotation: 0, opacity: 1, duration: 0.64, stagger: 0.08, ease: "back.out(1.45)", clearProps: "transform,opacity" }, 0.42)
      .fromTo(".fgen-hero .notice--left", { x: "-120vw", opacity: 0, rotation: -3.5, scale: 0.94 }, { x: 0, opacity: 1, rotation: -1.4, scale: 1, duration: 0.62, stagger: 0.08, clearProps: "opacity" }, 1.28)
      .fromTo(".fgen-hero .notice--right", { x: "120vw", opacity: 0, rotation: 3.5, scale: 0.94 }, { x: 0, opacity: 1, rotation: 1.4, scale: 1, duration: 0.62, stagger: 0.08, clearProps: "opacity" }, 1.42);

    if (quote) {
      gsap.set(".quote-word", { opacity: 0, y: 12 });
      gsap.set(".quote-caret", { opacity: 0 });
      gsap.timeline({
        defaults: { ease: "none" },
        scrollTrigger: { trigger: ".quote-shell", start: "top 90%", end: "center 55%", scrub: true, invalidateOnRefresh: true },
      })
        .to(".quote-word", { opacity: 1, y: 0, duration: 0.3, stagger: 0.15 })
        .to(".quote-caret", { opacity: 1, duration: 0.15 });
    }

    let pointerFrame = 0;
    let pointer: PointerEvent | null = null;
    const clamp = gsap.utils.clamp;
    const move = (event: PointerEvent) => {
      if (event.pointerType === "touch") return;
      pointer = event;
      if (pointerFrame) return;
      pointerFrame = requestAnimationFrame(() => {
        pointerFrame = 0;
        if (!pointer) return;
        if (!bounds.size) targets.forEach((element) => bounds.set(element, element.getBoundingClientRect()));
        words.forEach((word) => {
          const box = bounds.get(word)!;
          const dx = pointer!.clientX - box.left - box.width / 2;
          const dy = pointer!.clientY - box.top - box.height / 2;
          const influence = Math.max(0, 1 - Math.hypot(dx, dy) / 230);
          word.style.transform = `translate3d(${dx * influence * 0.08}px, ${dy * influence * 0.065}px, 0) rotate(${clamp(-1.4, 1.4, dx * influence * 0.012)}deg)`;
        });
        mediaCards.forEach((card) => {
          const box = bounds.get(card)!;
          const rotateY = clamp(-2.5, 2.5, ((pointer!.clientX - box.left - box.width / 2) / Math.max(box.width, 1)) * 2.5);
          const rotateX = clamp(-2.5, 2.5, ((pointer!.clientY - box.top - box.height / 2) / Math.max(box.height, 1)) * -2.5);
          card.style.transform = `perspective(900px) rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
        });
      });
    };
    const resetPointer = () => {
      cancelAnimationFrame(pointerFrame);
      pointerFrame = 0;
      pointer = null;
      targets.forEach((element) => { element.style.transform = ""; });
      invalidateBounds();
    };
    const tapTimers = new Map<HTMLElement, number>();
    const tap = (event: PointerEvent) => {
      if (event.pointerType !== "touch") return;
      const word = (event.target as Element).closest<HTMLElement>(".word");
      if (!word) return;
      window.clearTimeout(tapTimers.get(word));
      word.classList.add("is-tapped");
      tapTimers.set(word, window.setTimeout(() => { word.classList.remove("is-tapped"); tapTimers.delete(word); }, 520));
    };
    hero?.addEventListener("pointermove", move);
    hero?.addEventListener("pointerleave", resetPointer);
    hero?.addEventListener("pointerup", tap);
    window.addEventListener("scroll", resetPointer, { passive: true });
    window.addEventListener("resize", resetPointer, { passive: true });
    document.fonts.ready.then(invalidateBounds);
    return () => {
      resetPointer();
      tapTimers.forEach((timer, word) => { clearTimeout(timer); word.classList.remove("is-tapped"); });
      hero?.removeEventListener("pointermove", move);
      hero?.removeEventListener("pointerleave", resetPointer);
      hero?.removeEventListener("pointerup", tap);
      window.removeEventListener("scroll", resetPointer);
      window.removeEventListener("resize", resetPointer);
    };
  });
</script>
