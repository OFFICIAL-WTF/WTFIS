---
import SiteLayout from "../layouts/SiteLayout.astro";
import CompanyScroller from "../components/CompanyScroller.astro";

const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const projects = [
  {
    name: "FGEN",
    label: "fuckinggen",
    description: "Images from your own ChatGPT subscription, straight from the terminal. CLI and a real TUI.",
    href: `${base}fgen/`,
    docs: `${base}fgen/docs/`,
    github: "https://github.com/prophesourvolodymyr/fuckinggen",
    logo: `${base}assets/fgen/logo.png`,
    logoAlt: "FGEN logo",
  },
  {
    name: "WTFIS",
    label: "wtfis",
    description: "A local-first terminal finder for getting back to the folder you meant.",
    href: `${base}wtfis/`,
    docs: `${base}docs/`,
    github: "https://github.com/prophesourvolodymyr/WTFIS",
    logo: `${base}WTFIS%20logo%20main.png`,
    logoAlt: "WTFIS logo",
  },
  {
    name: "FGIT",
    label: "fgit",
    description: "A terminal-first workflow for reviewing changes, drafting commits, and choosing where they go.",
    href: "https://github.com/prophesourvolodymyr/FGIT",
    docs: "https://github.com/prophesourvolodymyr/FGIT",
    github: "https://github.com/prophesourvolodymyr/FGIT",
    logo: undefined,
    logoAlt: "",
  },
] as const;
---

<SiteLayout title="WTF / projects" product="wtf">
  <main class="hub-main">
    <section class="hub-hero" aria-labelledby="hub-title">
      <div class="hero-shell hub-hero-shell">
        <div class="title-stage hub-title-stage">
          <h1 class="title-lockup hub-title-lockup" id="hub-title" aria-label="Where The Fuck Are These Projects?">
            <span class="title-row">
              <span class="word"><span class="word-text">Where</span></span>
              <span class="media-card media-card--image media-card--people" role="img" aria-label="Developer working at a computer">
                <span class="media-card__surface"><img class="hero-media-image" src={`${base}People%20image%201.png`} alt="" width="1448" height="1086" /></span>
              </span>
              <span class="word"><span class="word-text">The</span></span>
            </span>
            <span class="title-row">
              <span class="word"><span class="word-text">Fuck</span></span>
              <span class="media-card media-card--image media-card--wide" role="img" aria-label="A red flower over a blue field">
                <span class="media-card__surface"><img class="hero-media-image" src={`${base}2026%20image%203.png`} alt="" width="1916" height="821" /></span>
              </span>
              <span class="word"><span class="word-text">Are</span></span>
            </span>
            <span class="title-row">
              <span class="word"><span class="word-text">These</span></span>
              <span class="media-card media-card--image media-card--cdx" role="img" aria-label="A failed change-directory command">
                <span class="media-card__surface"><img class="hero-media-image" src={`${base}CD%20X.png`} alt="" width="1448" height="1086" /></span>
              </span>
              <span class="word"><span class="word-text">Projects?</span></span>
            </span>
          </h1>
        </div>
        <CompanyScroller />
      </div>
    </section>

    <section class="hub-projects" id="projects" aria-labelledby="projects-title" data-nav-light>
      <div class="hub-projects-inner">
        <header class="hub-projects-header">
          <p class="hub-kicker">open-source projects</p>
          <h2 id="projects-title">Pick a tool.</h2>
        </header>
        <div class="hub-project-grid">
          {projects.map((project) => (
            <article class="hub-project-card">
              <div class="hub-project-card-top">
                {project.logo ? (
                  <img class:list={["hub-project-logo", project.name === "FGEN" && "hub-project-logo--fgen"]} src={project.logo} alt={project.logoAlt} width="512" height="512" loading="lazy" />
                ) : (
                  <span class="hub-project-wordmark" aria-label="FGIT">&gt;FGIT</span>
                )}
                <span class="hub-project-label">{project.label}</span>
              </div>
              <h3>{project.name}</h3>
              <p>{project.description}</p>
              <nav class="hub-project-links" aria-label={`${project.name} links`}>
                <a href={project.href}>{project.name === "FGIT" ? "repository" : "open"}</a>
                <a href={project.docs}>{project.name === "FGIT" ? "source" : "docs"}</a>
                <a href={project.github} target="_blank" rel="noreferrer">github</a>
              </nav>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
</SiteLayout>

<style is:global>
  .hub-main {
    position: relative;
    z-index: 1;
  }

  .hub-hero {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    background: transparent;
  }

  .hub-hero-shell {
    min-height: 100svh;
    padding-top: 4.8rem;
  }

  .hub-title-stage {
    min-height: calc(100svh - 4.8rem);
    padding: 2rem 0 9.5rem;
  }

  .hub-title-lockup {
    font-size: clamp(2.65rem, 8.4vw, 9.4rem);
  }


  .hub-projects {
    position: relative;
    padding: clamp(4rem, 8vw, 8rem) var(--edge) clamp(5rem, 10vw, 10rem);
    background: var(--white);
    color: var(--ink);
  }

  .hub-projects-inner {
    width: min(100%, 110rem);
    margin: 0 auto;
  }

  .hub-projects-header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: clamp(2rem, 5vw, 4.5rem);
  }

  .hub-kicker,
  .hub-project-label {
    margin: 0;
    color: var(--electric-blue);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .hub-projects h2 {
    max-width: 7ch;
    margin: 0;
    color: var(--electric-blue-deep);
    font-family: "Inter", sans-serif;
    font-size: clamp(3.8rem, 10vw, 10rem);
    font-weight: 900;
    letter-spacing: -0.1em;
    line-height: 0.76;
  }

  .hub-project-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.8rem, 1.4vw, 1.4rem);
  }

  .hub-project-card {
    display: flex;
    min-height: 25rem;
    flex-direction: column;
    padding: clamp(1.15rem, 2.3vw, 2.2rem);
    border: 1px solid rgba(16, 39, 133, 0.17);
    background: #fff;
    box-shadow: 0.42rem 0.48rem 0 rgba(16, 39, 133, 0.12);
  }

  .hub-project-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 4rem;
    gap: 1rem;
  }

  .hub-project-logo {
    display: block;
    width: 4.2rem;
    height: 4.2rem;
    object-fit: contain;
  }

  .hub-project-logo--fgen {
    border-radius: 0.7rem;
    padding: 0.25rem;
    background: var(--electric-blue-deep);
  }

  .hub-project-wordmark {
    color: var(--electric-blue);
    font-family: "Inter", sans-serif;
    font-size: clamp(2rem, 4vw, 4rem);
    font-weight: 900;
    letter-spacing: -0.12em;
    line-height: 0.8;
  }

  .hub-project-card h3 {
    margin: auto 0 0.8rem;
    color: var(--electric-blue-deep);
    font-family: "Inter", sans-serif;
    font-size: clamp(2.6rem, 5vw, 5.6rem);
    font-weight: 900;
    letter-spacing: -0.1em;
    line-height: 0.78;
  }

  .hub-project-card p {
    max-width: 31rem;
    margin: 0;
    color: rgba(16, 39, 133, 0.7);
    font-size: 0.75rem;
    line-height: 1.65;
  }

  .hub-project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.8rem;
  }

  .hub-project-links a {
    color: var(--electric-blue-deep);
    font-size: 0.62rem;
    font-weight: 600;
    text-decoration: none;
    text-transform: lowercase;
  }

  .hub-project-links a::after {
    content: " ↗";
    color: var(--electric-blue);
  }

  .hub-project-links a:hover,
  .hub-project-links a:focus-visible {
    color: var(--electric-blue);
    outline: none;
  }

  @media (max-width: 760px) {
    .hub-title-lockup {
      font-size: clamp(1.9rem, 8.3vw, 4.5rem);
    }

    .hub-hero-shell {
      padding-top: 4.2rem;
    }

    .hub-title-stage {
      min-height: calc(100svh - 4.2rem);
      padding-bottom: 10rem;
    }

    .hub-projects-header {
      align-items: flex-start;
      flex-direction: column;
    }

    .hub-project-grid {
      grid-template-columns: 1fr;
    }

    .hub-project-card {
      min-height: 19rem;
    }
  }
</style>
