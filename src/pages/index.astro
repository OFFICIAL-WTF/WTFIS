---
import SiteLayout from "../layouts/SiteLayout.astro";
import CompanyScroller from "../components/CompanyScroller.astro";

const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const projects = [
  {
    name: "FGEN",
    description: "Images from your terminal.",
    href: `${base}fgen/`,
    docs: `${base}fgen/docs/`,
    github: "https://github.com/prophesourvolodymyr/fuckinggen",
    logo: `${base}assets/fgen/logo.png`,
    logoAlt: "FGEN logo",
  },
  {
    name: "WTFIS",
    description: "Find the folder you meant.",
    href: `${base}wtfis/`,
    docs: `${base}docs/`,
    github: "https://github.com/prophesourvolodymyr/WTFIS",
    logo: `${base}WTFIS%20logo%20main.png`,
    logoAlt: "WTFIS logo",
  },
  {
    name: "FGIT",
    description: "Review changes. Ship commits.",
    href: "https://github.com/prophesourvolodymyr/FGIT",
    docs: "https://github.com/prophesourvolodymyr/FGIT",
    github: "https://github.com/prophesourvolodymyr/FGIT",
    logo: `${base}assets/wtf/fgit-logo.png`,
    logoAlt: "FGIT branching terminal logo",
  },
] as const;
---

<SiteLayout title="WTF / Where the Fuck is this Feature" product="wtf">
  <main class="hub-main">
    <section class="hub-hero" aria-labelledby="hub-title">
      <div class="hero-shell hub-hero-shell">
        <div class="title-stage hub-title-stage">
          <img class="hub-logo" src={`${base}assets/wtf/logo.png`} alt="WTF" width="768" height="384" fetchpriority="high" />
          <h1 class="title-lockup hub-title-lockup" id="hub-title" aria-label="Where the Fuck is this Feature">
            <span class="title-row">
              <span class="word"><span class="word-text">Where</span></span>{" "}
              <span class="media-card media-card--image media-card--people" role="img" aria-label="A magnifying glass searching for a missing feature">
                <span class="media-card__surface"><img class="hero-media-image" src={`${base}assets/wtf/feature-search.webp`} alt="" width="720" height="540" /></span>
              </span>
              <span class="word"><span class="word-text">the</span></span>
            </span>{" "}
            <span class="title-row">
              <span class="word"><span class="word-text">Fuck</span></span>{" "}
              <span class="media-card media-card--image media-card--wide" role="img" aria-label="A question-mark key beside an empty keyboard socket">
                <span class="media-card__surface"><img class="hero-media-image" src={`${base}assets/wtf/missing-feature.webp`} alt="" width="840" height="360" /></span>
              </span>
              <span class="word"><span class="word-text">is</span></span>
            </span>{" "}
            <span class="title-row">
              <span class="word"><span class="word-text">this</span></span>{" "}
              <span class="media-card media-card--image media-card--cdx" role="img" aria-label="The missing feature piece finding its place">
                <span class="media-card__surface"><img class="hero-media-image" src={`${base}assets/wtf/feature-piece.webp`} alt="" width="720" height="540" /></span>
              </span>
              <span class="word"><span class="word-text">Feature</span></span>
            </span>
          </h1>
        </div>
        <CompanyScroller />
      </div>
    </section>

    <section class="hub-projects" id="projects" aria-labelledby="projects-title" data-nav-light>
      <div class="hub-projects-inner">
        <header class="hub-projects-header">
          <p class="hub-kicker">open-source projects</p>
          <h2 id="projects-title">Pick a tool.</h2>
        </header>
        <div class="hub-project-grid">
          {projects.map((project) => (
            <article class="hub-project-card">
              <img class:list={["hub-project-logo", project.name === "FGEN" && "hub-project-logo--fgen"]} src={project.logo} alt={project.logoAlt} width="512" height="512" loading="lazy" />
              <h3>{project.name}</h3>
              <p>{project.description}</p>
              <nav class="hub-project-links" aria-label={`${project.name} links`}>
                <a class="menu-pill menu-cta" href={project.href}>{project.name === "FGIT" ? "repository" : "open"}</a>
                <a class="menu-pill" href={project.docs}>{project.name === "FGIT" ? "source" : "docs"}</a>
                <a class="menu-pill" href={project.github} target="_blank" rel="noreferrer">github</a>
              </nav>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
</SiteLayout>

<style is:global>
  .hub-main {
    position: relative;
    z-index: 1;
  }

  .hub-hero {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    background: transparent;
  }

  .hub-hero-shell {
    min-height: 100svh;
    padding-top: 4.8rem;
  }

  .hub-title-stage {
    min-height: calc(100svh - 4.8rem);
    gap: clamp(0.75rem, 2svh, 1.5rem);
    padding: 1.5rem 0 10.5rem;
  }

  .hub-logo {
    display: block;
    flex: 0 0 auto;
    width: clamp(8rem, 15vw, 14rem);
    height: auto;
    max-height: 13svh;
    object-fit: contain;
  }

  .hub-title-lockup {
    font-size: clamp(2.8rem, min(12vw, 18svh), 13rem);
  }

  .hub-hero .hero-media-image {
    object-fit: cover;
    background: transparent;
  }


  .hub-projects {
    position: relative;
    padding: clamp(4rem, 8vw, 8rem) var(--edge) clamp(5rem, 10vw, 10rem);
    background: var(--white);
    color: var(--ink);
  }

  .hub-projects-inner {
    width: min(100%, 110rem);
    margin: 0 auto;
  }

  .hub-projects-header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: clamp(2rem, 5vw, 4.5rem);
  }

  .hub-kicker {
    margin: 0;
    color: var(--electric-blue);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .hub-projects h2 {
    max-width: 7ch;
    margin: 0;
    color: var(--electric-blue-deep);
    font-family: "Inter", sans-serif;
    font-size: clamp(3.8rem, 10vw, 10rem);
    font-weight: 900;
    letter-spacing: -0.1em;
    line-height: 0.76;
  }

  .hub-project-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.8rem, 1.4vw, 1.4rem);
  }

  .hub-project-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: clamp(2rem, 3.2vw, 3rem) clamp(1.25rem, 2vw, 2rem);
    border: 1px solid rgba(16, 39, 133, 0.17);
    background: #fff;
    box-shadow: 0.42rem 0.48rem 0 rgba(16, 39, 133, 0.12);
    text-align: center;
  }


  .hub-project-logo {
    display: block;
    width: clamp(8rem, 13vw, 11rem);
    height: clamp(8rem, 13vw, 11rem);
    margin-bottom: 1.5rem;
    object-fit: contain;
  }

  .hub-project-logo--fgen {
    border-radius: 1.25rem;
    padding: 0.65rem;
    background: var(--electric-blue-deep);
  }


  .hub-project-card h3 {
    margin: 0 0 0.85rem;
    color: var(--electric-blue-deep);
    font-family: "Inter", sans-serif;
    font-size: clamp(2.8rem, 4.5vw, 4.5rem);
    font-weight: 900;
    letter-spacing: -0.1em;
    line-height: 0.9;
  }

  .hub-project-card p {
    max-width: 100%;
    margin: 0;
    color: rgba(16, 39, 133, 0.7);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .hub-project-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.45rem;
    margin-top: 1.75rem;
  }

  .hub-project-links .menu-pill:not(.menu-cta) {
    border-color: rgba(16, 39, 133, 0.28);
    background: transparent;
    color: var(--electric-blue-deep);
  }

  .hub-project-links .menu-pill:hover {
    border-color: var(--electric-blue);
    background: var(--electric-blue);
    color: var(--white);
  }

  .hub-project-links .menu-pill:focus-visible {
    outline-color: var(--electric-blue);
  }

  @media (max-width: 960px) {
    .hub-project-grid {
      grid-template-columns: 1fr;
      max-width: 34rem;
      margin-inline: auto;
    }
  }

  @media (max-width: 760px) {
    .hub-title-lockup {
      font-size: clamp(2.25rem, 12.1vw, 6.25rem);
    }

    .hub-hero-shell {
      padding-top: 4.2rem;
    }

    .hub-title-stage {
      min-height: calc(100svh - 4.2rem);
      padding-bottom: 10rem;
    }

    .hub-projects-header {
      align-items: flex-start;
      flex-direction: column;
    }
    .hub-logo {
      width: clamp(8rem, 34vw, 12rem);
    }
  }
</style>
