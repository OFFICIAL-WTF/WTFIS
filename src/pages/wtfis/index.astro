        function showToast(message) {
          if (!labToast) return;

          window.clearTimeout(toastTimer);
          labToast.textContent = message;
          labToast.classList.add("is-visible");
          toastTimer = window.setTimeout(() => labToast.classList.remove("is-visible"), 2200);
        }

        function resolveDirectory(input) {
          const value = input.trim().replace(/^['"]|['"]$/g, "");
          if (!value) return homeDirectory;
          if (value === "-") return previousDirectory;

          let base = value;
          if (base === "~") {
            base = homeDirectory;
          } else if (base.startsWith("~/")) {
            base = `${homeDirectory}${base.slice(1)}`;
          } else if (!base.startsWith("/")) {
            base = `${currentDirectory}/${base}`;
          }

          const segments = [];
          base.split("/").forEach((segment) => {
            if (!segment || segment === ".") return;
            if (segment === "..") {
              segments.pop();
              return;
            }
            segments.push(segment);
          });

          return `/${segments.join("/")}` || "/";
        }

        function directoryExists(path) {
          const fixedDirectories = ["/", "/Users", homeDirectory, projectRoot];
          return fixedDirectories.includes(path) || labProjects.some((project) => project.path === path);
        }

        function terminalDirectoryName(path) {
          const normalized = path.replace(/\/+$/, "");
          return normalized === projectRoot ? "" : normalized.split("/").pop() || "";
        }

        function terminalPrompt(path, command) {
          return `% ${command}`;
        }

        function finderCommand() {
          return terminalMode === "cdd" ? "cdd" : "wtfis";
        }

        function updateTerminalState() {
          if (cdPrompt) cdPrompt.textContent = terminalPrompt(currentDirectory, "cd");
          if (wtfisPrompt) wtfisPrompt.textContent = terminalPrompt(currentDirectory, finderCommand());
        }

        function getCliMatches(query) {
          const normalizedQuery = normalizeSearch(query);
          if (!normalizedQuery) return labProjects.slice(0, 4);

          return labProjects
            .map((project) => {
              const name = normalizeSearch(project.name);
              const distance = editDistance(normalizedQuery, name);
              const contains = name.includes(normalizedQuery) || normalizedQuery.includes(name);
              return { project, distance, contains };
            })
            .filter(({ contains, distance }) => contains || distance <= Math.max(1, Math.floor(normalizedQuery.length / 3)))
            .sort((left, right) => Number(right.contains) - Number(left.contains) || left.distance - right.distance)
            .slice(0, 4)
            .map(({ project }) => project);
        }

        function renderCliResults(query = "", selectedProject = null) {
          if (!cliResults) return;

          const normalizedQuery = normalizeSearch(query);
          const matches = getCliMatches(query);
          if (selectedProject && !matches.includes(selectedProject)) matches.unshift(selectedProject);

          cliResults.replaceChildren();
          if (!matches.length) {
            const empty = document.createElement("p");
            empty.className = "cli-empty";
            empty.textContent = normalizedQuery ? "No matching folders" : "Your recent projects will appear here";
            cliResults.appendChild(empty);
            return;
          }

          const selectedIndex = selectedProject ? matches.indexOf(selectedProject) : Math.min(cliSelectedIndex, matches.length - 1);
          cliSelectedIndex = Math.max(0, selectedIndex);

          matches.forEach((project, index) => {
            const row = document.createElement("div");
            const isSelected = index === cliSelectedIndex;
            row.className = `cli-result${isSelected ? " is-selected" : ""}`;
            const marker = document.createElement("span");
            marker.className = "cli-result-marker";
            marker.textContent = isSelected ? "[›]" : "   ";
            const name = document.createElement("span");
            name.textContent = project.name;
            const path = document.createElement("span");
            path.className = "cli-result-path";
            path.textContent = project.path;
            row.append(marker, name, path);
            cliResults.appendChild(row);
          });
        }

        function setTerminalMode(nextMode) {
          if (!["wtfis", "cli", "cdd"].includes(nextMode)) return;

          terminalMode = nextMode;
          const isCli = nextMode === "cli";
          const command = finderCommand();
          finderTerminal?.classList.toggle("is-cli", isCli);
          finderTerminal?.setAttribute("aria-label", isCli ? "WTFIS interactive CLI" : `Test ${command} shell`);
          if (finderTerminalName) finderTerminalName.textContent = `TERMINAL / ${isCli ? "WTFIS CLI" : command.toUpperCase()}`;
          terminalModeTabs.forEach((tab) => tab.setAttribute("aria-pressed", String(tab.dataset.terminalMode === nextMode)));
          if (wtfisForm) wtfisForm.hidden = isCli;
          if (wtfisHistory) wtfisHistory.hidden = isCli;
          if (cliSimulator) cliSimulator.hidden = !isCli;
          if (wtfisInput) wtfisInput.setAttribute("aria-label", `Project name to test with ${command.toUpperCase()}`);
          clearTerminalNotifications();
          updateTerminalState();
          if (isCli) {
            cliSelectedIndex = 0;
            renderCliResults(cliInput?.value || "");
            cliInput?.focus({ preventScroll: true });
          } else {
            wtfisInput?.focus({ preventScroll: true });
          }
        }

        function formatDuration(seconds) {
          seconds = Math.max(0, Math.round(seconds));
          if (seconds < 60) return `${String(seconds).padStart(2, "0")}s`;
          const minutes = Math.floor(seconds / 60);
          const remainingSeconds = seconds % 60;
          if (minutes < 60) return `${String(minutes).padStart(2, "0")}m ${String(remainingSeconds).padStart(2, "0")}s`;
          const hours = Math.floor(minutes / 60);
          return `${String(hours).padStart(2, "0")}h ${String(minutes % 60).padStart(2, "0")}m`;
        }

        function setTerminalNotification(element, kicker, title, copy, state = "success") {
          if (!element) return;
          const previousTimer = notificationTimers.get(element);
          if (previousTimer) window.clearTimeout(previousTimer);
          const prefix = element.id.startsWith("cd-") ? "cd" : "wtfis";
          const kickerElement = document.querySelector(`#${prefix}-notification-kicker`);
          const titleElement = document.querySelector(`#${prefix}-notification-title`);
          const copyElement = document.querySelector(`#${prefix}-notification-copy`);

          if (kickerElement) kickerElement.textContent = kicker;
          if (titleElement) titleElement.textContent = title;
          if (copyElement) copyElement.textContent = copy;
           element.classList.toggle("is-warning", state === "warning");
           element.classList.toggle("is-error", state === "error");
           element.classList.toggle("is-success", state === "success");
           element.classList.add("is-visible");
          notificationTimers.set(element, window.setTimeout(() => {
             element.classList.remove("is-visible", "is-warning", "is-error", "is-success");
            notificationTimers.delete(element);
          }, 2000));
         }

        function clearTerminalNotifications() {
          [cdNotification, wtfisNotification].forEach((element) => {
            const timer = element && notificationTimers.get(element);
            if (timer) window.clearTimeout(timer);
            element?.classList.remove("is-visible", "is-warning", "is-error", "is-success");
            if (element) notificationTimers.delete(element);
          });
        }

        function updateOutcome(mode, project = null, detail = {}) {
          if (mode === "default") {
            clearTerminalNotifications();
            return;
          }

          if (mode === "saved") {
            const savedSeconds = detail.savedSeconds ?? Math.max(18, 300 - Math.min(282, cdWasteSeconds));
            setTerminalNotification(
              wtfisNotification,
              "CONGRATS",
              project?.name || terminalDirectoryName(currentDirectory) || "Project",
              `${formatDuration(savedSeconds)} saved / 1 command / ★★★★★`,
              "success",
            );
            return;
          }

          if (mode === "wtfis-error") {
            setTerminalNotification(wtfisNotification, finderCommand().toUpperCase(), "No match", "cwd unchanged", "error");
            return;
          }

          if (mode === "manual") {
            setTerminalNotification(
              cdNotification,
              "SLOW ROUTE",
              project?.name || terminalDirectoryName(currentDirectory) || "Directory",
              `${detail.pasted ? "clipboard" : "typed"} / ${formatDuration(detail.manualSeconds)} spent`,
              "warning",
            );
            return;
          }

          if (mode === "error") {
            setTerminalNotification(
              cdNotification,
              "PATH ERROR",
              "No such directory",
              `+${formatDuration(18)} / ${cdWrongTurns} wrong turn${cdWrongTurns === 1 ? "" : "s"}`,
              "error",
            );
          }
        }

        async function copyText(value, message = "Copied to clipboard.") {
          try {
            await navigator.clipboard.writeText(value);
          } catch {
            const fallback = document.createElement("textarea");
            fallback.value = value;
            fallback.setAttribute("readonly", "");
            fallback.style.position = "fixed";
            fallback.style.opacity = "0";
            document.body.appendChild(fallback);
            fallback.select();
            document.execCommand("copy");
            fallback.remove();
          }

          showToast(message);
        }

        function randomProjectName(used) {
          const prefixes = ["Atomic", "Copper", "Lunar", "Neon", "Quiet", "Rapid", "Velvet", "Wild"];
          const nouns = ["Canvas", "Forge", "Harbor", "Ledger", "Orbit", "Relay", "Signal", "Studio"];
          let name = "";

          do {
            name = `${prefixes[Math.floor(Math.random() * prefixes.length)]}${nouns[Math.floor(Math.random() * nouns.length)]}`;
          } while (used.has(name));

          used.add(name);
          return name;
        }

        function dismissCoach() {
          if (!coachCursor) return;

          coachTimeline?.kill();
          coachTimeline = null;

          if (hasGsap) {
            gsap.to(coachCursor, { autoAlpha: 0, scale: 0.8, duration: 0.28, overwrite: true });
          } else {
            coachCursor.style.display = "none";
          }
        }

        function positionCoach() {
          if (!coachCursor || !fakeFinder || !generatedProject || !hasGsap || reduceMotion) return;

          const target = finderFiles.querySelector(`[data-project-id="${generatedProject.id}"]`);
          if (!target) return;

          coachTimeline?.kill();
          const panelBounds = fakeFinder.getBoundingClientRect();
          const targetBounds = target.getBoundingClientRect();
          const targetX = targetBounds.left - panelBounds.left + targetBounds.width * 0.55;
          const targetY = targetBounds.top - panelBounds.top + targetBounds.height * 0.46;
          const startX = panelBounds.width - 125;
          const startY = panelBounds.height - 82;

          gsap.set(coachCursor, { autoAlpha: 1, x: startX, y: startY, scale: 1 });
          coachTimeline = gsap
            .timeline({ repeat: -1, repeatDelay: 0.7 })
            .to(coachCursor, { x: targetX, y: targetY, duration: 1.45, ease: "power2.inOut" })
            .call(() => coachCursor.classList.add("is-clicking"))
            .to(coachCursor, { scale: 0.9, duration: 0.12, yoyo: true, repeat: 1 })
            .call(() => coachCursor.classList.remove("is-clicking"))
            .to({}, { duration: 1.05 })
            .to(coachCursor, { autoAlpha: 0, duration: 0.25 });
        }

        function closeProjectPopup() {
          projectPopup?.classList.remove("is-open");
          finderFiles?.querySelectorAll(".file-item").forEach((item) => item.classList.remove("is-selected"));
