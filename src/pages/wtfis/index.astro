        function renderFilesystem() {
          if (!finderFiles) return;

          finderFiles.replaceChildren();

          labProjects.forEach((project) => {
            const item = document.createElement("button");
            item.type = "button";
            item.className = `file-item${project.generated ? " is-generated" : ""}`;
