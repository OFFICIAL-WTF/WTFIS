---
import "../../styles/wtfis.css";
import CompanyScroller from "../../components/CompanyScroller.astro";
import HeroNotifications from "../../components/HeroNotifications.astro";
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#1f42f3" />
    <title>WTFIS / People Spend 5 hours a Year Finding Directories</title>
    <link rel="icon" type="image/png" href={`${base}Tab%20logo.png?v=1`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@800;900&display=swap"
      rel="stylesheet"
    />
    <script>
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body>
    <div class="loading-screen" id="loading-screen" role="status" aria-live="polite">
      <div class="loading-mark">
        <strong id="loading-phrase">Fucking Hell.</strong>
      </div>
      <div class="loading-graph" aria-hidden="true">
        <svg viewBox="0 0 1 0.28" preserveAspectRatio="none">
          <path id="loading-graph-path" pathLength="1" d="M0 .24 .12 .2 .22 .23 .35 .12 .48 .18 .62 .08 .76 .14 .88 .03 1 .09" />
        </svg>
        <span class="loading-percent" id="loading-percent">1%</span>
      </div>
    </div>
    <div class="cursor-mask" aria-hidden="true"></div>
    <div class="unified-grid-layer" aria-hidden="true"></div>
    <nav class="top-nav wtfis-nav" aria-label="WTFIS showcase navigation">
      <a class="menu-brand" href="#pain-point" aria-label="WTFIS home">
        <img src={`${base}WTFIS%20logo%20main.png`} alt="" width="1024" height="1024" />
      </a>
      <div class="menu-links">
        <a class="menu-pill" href={base}>&gt;WTF</a>
        <a class="menu-pill" href={`${base}fgen/`}>FGEN</a>
        <a class="menu-pill" href={`${base}docs/`}>docs</a>
        <a class="menu-pill" href="https://github.com/prophesourvolodymyr/WTFIS" target="_blank" rel="noreferrer">github</a>
        <a class="menu-pill menu-coffee" href="https://buymeacoffee.com/professorvolodymyr" target="_blank" rel="noreferrer" aria-label="Support WTFIS">☕️</a>
        <a class="menu-pill menu-cta" id="cta-button" href="#cta-stage">try &gt;WTFIS</a>
      </div>
    </nav>
    <div class="scroll-story">
      <div class="transition-stage" id="scroll-scene">
        <div class="transition-frame">
          <section class="hero" id="pain-point" aria-labelledby="pain-point-title">
            <div class="hero-shell">
        <HeroNotifications />

        <main class="title-stage">
          <h1
            class="title-lockup"
            id="pain-point-title"
            aria-label="People Spend 5 hours a Year Finding Directories"
          >
            <span class="title-row">
              <span class="word" data-emoji="📁"><span class="word-text">People</span></span>
              <span class="media-card media-card--image media-card--people" role="img" aria-label="Developer working at a computer">
                <span class="media-card__surface">
                  <img class="hero-media-image" src={`${base}People%20image%201.png`} alt="" width="1448" height="1086" />
                </span>
              </span>
              <span class="word" data-emoji="⏳"><span class="word-text">Spend</span></span>
            </span>
            <span class="title-row">
              <span class="word" data-emoji="⌛"><span class="word-text">5</span></span>
              <span class="word" data-emoji="🕰️"><span class="word-text">hours</span></span>
              <span
                class="media-card media-card--video"
                id="video-card"
                role="img"
                aria-label="Animated terminal search"
              >
                <span class="media-card__surface">
                  <canvas class="terminal-canvas" aria-hidden="true"></canvas>
                </span>
              </span>
              <span class="word" data-emoji="🗓️"><span class="word-text">a Year</span></span>
              <span class="media-card media-card--image media-card--wide" role="img" aria-label="2026 with a red flower">
                <span class="media-card__surface">
                  <img class="hero-media-image" src={`${base}2026%20image%203.png`} alt="" width="1916" height="821" />
                </span>
              </span>
            </span>
            <span class="title-row">
              <span class="word" data-emoji="🔎"><span class="word-text">Finding</span></span>
              <span class="media-card media-card--image media-card--cdx" role="img" aria-label="A failed change-directory command">
                <span class="media-card__surface">
                  <img class="hero-media-image" src={`${base}CD%20X.png`} alt="" width="1448" height="1086" />
                </span>
              </span>
              <span class="word" data-emoji="📂"><span class="word-text">Directories</span></span>
            </span>
          </h1>
          <CompanyScroller />
        </main>

            </div>
          </section>

          <section class="what-section" id="what-is" aria-labelledby="what-title">
            <div class="previous-section-shadow" aria-hidden="true">People Spend<br />Finding Directories</div>
            <div class="what-shell">
              <h2 class="what-title" id="what-title" aria-label='Just Find "Where The Fuck It Is" In One Command.'>
                <span class="what-title-row what-title-row--first what-title-row--interactive">
                  <span class="what-word" data-emoji="📌">Just</span>
                  <span class="what-word" data-emoji="🔎">Find</span>
                </span>
                <span class="what-title-row what-title-row--second">
                  <span class="morph-zone">
                    <span class="human-phrase">
                      <span class="morph-token">"Where</span>
                      <span class="morph-token">The</span>
                      <span class="morph-token">Fuck</span>
                      <span class="morph-token">It</span>
                      <span class="morph-token">Is"</span>
                    </span>
                    <span class="command-shell" aria-hidden="true">
                      <span class="shell-dots" aria-hidden="true">
                        <i></i>
                        <i></i>
                        <i></i>
                      </span>
                      <span class="shell-line">
                        <span class="command-prefix">$ WTFIS</span>
                        <span class="command-suffix"></span>
                        <span class="command-caret" aria-hidden="true"></span>
                      </span>
                    </span>
                  </span>
                </span>
                <span class="what-title-row what-title-row--third what-title-row--interactive">
                  <span class="what-word" data-emoji="🧩">In</span>
                  <span class="what-word" data-emoji="1️⃣">One</span>
                  <span class="what-word" data-emoji="⌨️">Command.</span>
                </span>
              </h2>
            </div>
          </section>
          <div class="white-curtain" aria-hidden="true"></div>
        </div>
      </div>
    </div>

    <section class="playground-section" id="playground" aria-labelledby="playground-title">
      <div class="playground-frame">
        <div class="playground-shell">
        <header class="playground-header">
          <div>
            <h2 class="playground-title" id="playground-title">Compare Routes.</h2>
          </div>
        </header>

        <div class="lab-layout">
          <section class="finder-panel" id="fake-finder" aria-label="Generated fake filesystem">
            <div class="window-bar">
              <span class="window-dot"></span>
              <span class="window-dot"></span>
              <span class="window-dot"></span>
              <span class="window-title">Fake Finder / Projects</span>
              <button class="finder-regenerate" id="finder-regenerate" type="button">regenerate</button>
            </div>
            <div class="finder-breadcrumbs" aria-hidden="true">
              <span>Macintosh HD</span><span>/</span><span>Users</span><span>/</span><span>visitor</span><span>/</span><strong>Projects</strong>
            </div>
            <div class="finder-files" id="finder-files"></div>

            <div class="coach-cursor" id="coach-cursor" aria-hidden="true">
              <svg viewBox="0 0 30 36" xmlns="http://www.w3.org/2000/svg">
                <path d="M2 2v27l7.6-7.2 5.1 11.2 5.1-2.4-5-10.8H26L2 2Z" fill="#fff" stroke="#09145b" stroke-width="2.2" stroke-linejoin="round" />
              </svg>
              <span>right-click</span>
            </div>

            <aside class="project-popup" id="project-popup" aria-label="Project path menu">
              <div class="context-menu-heading" id="popup-name">Project</div>
              <button class="context-menu-item" id="copy-project-path" type="button">
                <span id="copy-menu-label">Copy as Pathname</span><kbd>⌥⌘C</kbd>
              </button>
              <div class="context-menu-separator"></div>
              <button class="context-menu-item" id="popup-regenerate" type="button">
                <span>Regenerate Folder Set</span><kbd>⌘R</kbd>
              </button>
              <div class="context-menu-separator"></div>
              <div class="context-menu-path" id="popup-path">/Users/visitor/Projects/Project</div>
            </aside>
          </section>

          <div class="terminal-stack">
            <section class="terminal-panel" aria-label="Test cd shell">
              <div class="terminal-header">
                <span class="terminal-lights" aria-hidden="true"><i></i><i></i><i></i></span>
                <span class="terminal-name">TERMINAL / CD</span>
              </div>
              <aside class="terminal-notification" id="cd-notification" aria-live="polite">
                <span class="terminal-notification-kicker" id="cd-notification-kicker">PATH</span>
                <strong id="cd-notification-title"></strong>
                <span class="terminal-notification-copy" id="cd-notification-copy"></span>
              </aside>
              <div class="terminal-body">
                <form class="terminal-form" id="cd-form">
                  <label class="terminal-prompt" id="cd-prompt" for="cd-input">$ cd</label>
                  <input class="terminal-input" id="cd-input" type="text" autocomplete="off" spellcheck="false" aria-label="Path to test with cd" />
                </form>
                <div class="terminal-history" id="cd-history" aria-live="polite"></div>
              </div>
            </section>

            <div class="terminal-vs" aria-label="versus comparison">
              <span>VS</span>
            </div>

            <section class="terminal-panel" id="finder-terminal" aria-label="Test WTFIS shell">
              <div class="terminal-header">
                <span class="terminal-lights" aria-hidden="true"><i></i><i></i><i></i></span>
                <span class="terminal-name" id="finder-terminal-name">TERMINAL / WTFIS</span>
                <div class="terminal-mode-tabs" role="group" aria-label="Terminal mode">
                  <button class="terminal-mode-tab" type="button" aria-pressed="true" data-terminal-mode="wtfis">WTFIS</button>
                  <button class="terminal-mode-tab" type="button" aria-pressed="false" data-terminal-mode="cli">CLI</button>
                  <button class="terminal-mode-tab" type="button" aria-pressed="false" data-terminal-mode="cdd">CDD</button>
                </div>
              </div>
              <aside class="terminal-notification" id="wtfis-notification" aria-live="polite">
                <span class="terminal-notification-kicker" id="wtfis-notification-kicker">WTFIS</span>
                <strong id="wtfis-notification-title"></strong>
                <span class="terminal-notification-copy" id="wtfis-notification-copy"></span>
              </aside>
              <div class="terminal-body">
                <form class="terminal-form" id="wtfis-form">
                  <label class="terminal-prompt" id="wtfis-prompt" for="wtfis-input">$ wtfis</label>
                  <input class="terminal-input" id="wtfis-input" type="text" autocomplete="off" spellcheck="false" aria-label="Project name to test with WTFIS" placeholder="project name" />
                </form>
                <div class="terminal-history" id="wtfis-history" aria-live="polite"></div>
                <div class="cli-simulator" id="cli-simulator" hidden>
                  <div class="cli-window">
                    <div class="cli-titlebar"><strong>WTFIS</strong><span>interactive picker</span></div>
                    <form class="cli-search" id="cli-form">
                      <input id="cli-input" type="text" autocomplete="off" spellcheck="false" aria-label="Search projects with the WTFIS CLI" placeholder="Fucking Find Something..." />
                    </form>
                    <div class="cli-results" id="cli-results" aria-live="polite"></div>
                    <div class="cli-guide" aria-hidden="true"><b>↑↓</b> move <b>↵</b> open <b>esc</b> cancel <b>/</b> commands</div>
                  </div>
                </div>
              </div>
            </section>
          </div>
        </div>
        </div>
      </div>
    </section>
    <section class="cta-stage" id="cta-stage" aria-label="WTFIS installation">
      <div class="cta-stage-frame">
        <aside class="install-tray" id="install-tray" aria-label="Install WTFIS">
          <div class="install-layer-inner">
            <div class="install-copy">
              <h2 class="install-heading" id="install-heading">Find Folders Faster.</h2>
              <p class="install-subtitle">One command. Back to your folder.</p>
            </div>
            <div class="cta-gallery" id="cta-gallery" aria-label="WTFIS feature stack">
              <div class="cta-stack-inner scroll-stack-inner" id="cta-stack-inner">
                <figure class="cta-card scroll-stack-card">
                  <div class="cta-shot has-image">
                    <img class="cta-shot-image" src={`${base}Wtfis%20commands%20showcase.png`} alt="Terminal commands using wtfis and cdd to move between folders" decoding="async" width="1600" height="1200" />
                  </div>
                  <figcaption><strong>Easy as fuck commands.</strong><span>Like swearing? Type <code>wtfis</code>. In a hurry? <code>cdd</code>.</span></figcaption>
                </figure>
                <figure class="cta-card scroll-stack-card">
                  <div class="cta-shot has-image">
                    <img class="cta-shot-image" src={`${base}TUI%20showcase.png`} alt="WTFIS terminal interface listing matched directories" decoding="async" width="1541" height="1201" />
                  </div>
                    <figcaption><strong>Rich TUI.</strong><span>See the matches in your terminal, pick one, and get back to work.</span></figcaption>
                </figure>
                <figure class="cta-card scroll-stack-card">
                  <div class="cta-shot has-image">
                    <img class="cta-shot-image" src={`${base}COmmands%20showcase.png`} alt="WTFIS command shortcuts for finding directories" decoding="async" width="1541" height="1201" />
                  </div>
                  <figcaption><strong>Built-in commands.</strong><span>Use <code>cdd</code> to find the folder, then add a command for WTFIS to run after <code>cd</code>.</span></figcaption>
                </figure>
                <figure class="cta-card scroll-stack-card">
                  <div class="cta-shot has-image">
                    <img class="cta-shot-image" src={`${base}productivity-commands.png`} alt="WTFIS productivity commands for navigating folder history" decoding="async" width="1541" height="1201" />
                  </div>
                    <figcaption><strong>Productivity shortcuts.</strong><span>Use <code>--up</code>, <code>--prev</code>, and <code>--recent</code> instead of retracing your path.</span></figcaption>
                </figure>
                <figure class="cta-card scroll-stack-card">
                  <div class="cta-shot has-image">
                    <img class="cta-shot-image" src={`${base}settings-updated.png`} alt="WTFIS settings for configuring directory discovery" decoding="async" width="1541" height="1201" />
                  </div>
                    <figcaption><strong>Rich settings.</strong><span>Choose the folders WTFIS checks, how deep it looks, and what it runs.</span></figcaption>
                </figure>
                <div class="scroll-stack-end" id="cta-stack-end" aria-hidden="true"></div>
              </div>
            </div>
            <div class="install-shell" id="install-shell">
              <div class="install-shell-header">
                <span class="terminal-lights" aria-hidden="true"><i></i><i></i><i></i></span>
                <span class="terminal-name">TERMINAL / INSTALL</span>
              </div>
              <div class="install-shell-line">
                <span class="install-shell-prompt">$</span>
                <code>brew tap prophesourvolodymyr/wtfis &amp;&amp; brew install wtfis</code>
                <button class="copy-button" type="button" data-copy="brew tap prophesourvolodymyr/wtfis &amp;&amp; brew install wtfis">copy</button>
              </div>
            </div>
            <div class="install-platforms" id="install-platforms" aria-label="Supported platforms">
              <span aria-label="Apple"><img class="platform-icon" src="https://cdn.simpleicons.org/apple/1f42f3" alt="" loading="lazy" /></span>
              <span aria-label="Linux"><img class="platform-icon" src="https://cdn.simpleicons.org/linux/1f42f3" alt="" loading="lazy" /></span>
              <span aria-label="Windows">
                <svg class="platform-icon" viewBox="0 0 24 24" aria-hidden="true">
                  <path fill="currentColor" d="M2 3.6 10.1 2v9.4H2V3.6Zm9.9-1.9L22 0v11.4h-10.1V1.7ZM2 12.6h8.1V22L2 20.4v-7.8Zm9.9 0H22V24l-10.1-1.7v-9.7Z" />
                </svg>
              </span>
            </div>
          </div>
        </aside>
      </div>
    </section>

    <div class="lab-toast" id="lab-toast" role="status" aria-live="polite"></div>

    <footer class="site-footer">
      <div class="footer-mark" role="img" aria-label="WTFIS">
        <span class="footer-logo-fallback" aria-hidden="true">&gt;WTFIS</span>
      </div>
      <div class="footer-top">
        <span>You remembered the project. Not the path.</span>
        <nav class="footer-links" aria-label="Footer links">
          <a href={`${base}docs/`}>docs</a>
          <a href="https://github.com/prophesourvolodymyr/WTFIS" target="_blank" rel="noreferrer">github</a>
        </nav>
      </div>
      <div class="footer-bottom">
        <span>Find the folder, then move on.</span>
        <span>Open source.</span>
      </div>
    </footer>

    <script>
      // @ts-nocheck
      import { gsap } from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";
      import Lenis from "lenis";

      // Astro bundles these imports into one client script instead of loading CDN globals.
      gsap.registerPlugin(ScrollTrigger);

      (() => {
        const cursorMask = document.querySelector(".cursor-mask");
        const loadingScreen = document.querySelector("#loading-screen");
        const loadingPhrase = document.querySelector("#loading-phrase");
        const loadingPercent = document.querySelector("#loading-percent");
        const loadingGraphPath = document.querySelector("#loading-graph-path");
        const topNav = document.querySelector(".top-nav");
        const siteFooter = document.querySelector(".site-footer");
        const videoCard = document.querySelector("#video-card");
        const videoCanvas = document.querySelector(".terminal-canvas");
        const ctaButton = document.querySelector("#cta-button");
        const ctaGallery = document.querySelector("#cta-gallery");
        const companyScroller = document.querySelector("#company-scroller");
        const companyScrollerTrack = document.querySelector("#company-scroller-track");
        const mediaCards = [...document.querySelectorAll(".media-card")];
        const words = [...document.querySelectorAll(".word")];
        const notifications = [...document.querySelectorAll(".notification")];
        const whatSection = document.querySelector("#what-is");
        const whatTitle = document.querySelector(".what-title");
        const previousSectionShadow = document.querySelector(".previous-section-shadow");
        const whatHoverWords = [...document.querySelectorAll(".what-title-row--interactive .what-word")];
        const morphZone = document.querySelector(".morph-zone");
        const humanPhrase = document.querySelector(".human-phrase");
        const commandShell = document.querySelector(".command-shell");
        const commandSuffix = document.querySelector(".command-suffix");
        const unifiedGrid = document.querySelector(".unified-grid-layer");
        const whiteCurtain = document.querySelector(".white-curtain");
        const scrollScene = document.querySelector("#scroll-scene");
        const heroShell = document.querySelector(".hero-shell");
        const playground = document.querySelector("#playground");
        const ctaStage = document.querySelector("#cta-stage");
        const fakeFinder = document.querySelector("#fake-finder");
        const finderFiles = document.querySelector("#finder-files");
        const finderRegenerate = document.querySelector("#finder-regenerate");
        const popupRegenerate = document.querySelector("#popup-regenerate");
        const projectPopup = document.querySelector("#project-popup");
        const popupName = document.querySelector("#popup-name");
        const popupPath = document.querySelector("#popup-path");
        const copyMenuLabel = document.querySelector("#copy-menu-label");
        const copyProjectPath = document.querySelector("#copy-project-path");
        const coachCursor = document.querySelector("#coach-cursor");
        const cdForm = document.querySelector("#cd-form");
        const cdInput = document.querySelector("#cd-input");
         const cdHistory = document.querySelector("#cd-history");
         const cdPrompt = document.querySelector("#cd-prompt");
         const terminalPanels = [...document.querySelectorAll(".terminal-panel")];
          const cdNotification = document.querySelector("#cd-notification");
          const wtfisForm = document.querySelector("#wtfis-form");
          const wtfisInput = document.querySelector("#wtfis-input");
        const wtfisHistory = document.querySelector("#wtfis-history");
        const wtfisPrompt = document.querySelector("#wtfis-prompt");
        const wtfisNotification = document.querySelector("#wtfis-notification");
        const finderTerminal = document.querySelector("#finder-terminal");
        const finderTerminalName = document.querySelector("#finder-terminal-name");
        const terminalModeTabs = [...document.querySelectorAll("[data-terminal-mode]")];
        const cliSimulator = document.querySelector("#cli-simulator");
        const cliForm = document.querySelector("#cli-form");
        const cliInput = document.querySelector("#cli-input");
        const cliResults = document.querySelector("#cli-results");
          const labToast = document.querySelector("#lab-toast");
          const progressSteps = [...document.querySelectorAll(".progress-step")];
        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
         const finePointer = !window.matchMedia("(pointer: coarse)").matches;
           const hasGsap = Boolean(gsap && ScrollTrigger);
          const pointerBounds = new Map();
          let pointerBoundsReady = false;
          const homeDirectory = "/Users/visitor";
         const projectRoot = `${homeDirectory}/Projects`;

        let videoRunning = false;
        let videoRequested = false;
        let videoVisible = true;
        let videoFrame = 0;
        let videoContext = null;
        let canvasWidth = 0;
        let canvasHeight = 0;
        let commandLoopStarted = false;
        let commandTimer = 0;
        let labProjects = [];
        let generatedProject = null;
        let popupProject = null;
        let coachTimeline = null;
        let toastTimer = 0;
         let playgroundVisible = false;
          let currentDirectory = projectRoot;
         let previousDirectory = currentDirectory;
        let cdWasteSeconds = 0;
        let cdWrongTurns = 0;
        let cdEntryWasPasted = false;
        let terminalMode = "wtfis";
        let cliSelectedIndex = 0;
           const notificationTimers = new WeakMap();
          let morphOpenWidthPx = 0;
          let morphPhraseFit = 1;
          let sectionTwoAnimationStarted = false;
          let sectionTwoTimeline = null;
            let autoScrollTween = null;
            let lenis = null;
            let lenisTicker = null;
            let updateCtaScrollStack = null;

        function setupLenis() {
          if (!hasGsap || reduceMotion) return;

          lenis = new Lenis({ lerp: 0.08, smoothWheel: true });
          lenis.on("scroll", ScrollTrigger.update);
          lenisTicker = (time) => lenis.raf(time * 1000);
          gsap.ticker.add(lenisTicker);
          gsap.ticker.lagSmoothing(0);
        }

        function setScrollPosition(top) {
          if (lenis) {
            lenis.scrollTo(top, { immediate: true, force: true });
            return;
          }

          window.scrollTo(0, top);
        }

        function setupCompanyScroller() {
          if (!companyScroller || !companyScrollerTrack) return;

          if (!companyScrollerTrack.querySelector("[aria-hidden='true']")) {
            [...companyScrollerTrack.children].forEach((chip) => {
              const duplicate = chip.cloneNode(true);
              duplicate.setAttribute("aria-hidden", "true");
              companyScrollerTrack.append(duplicate);
            });
          }

          let slowTimer = 0;
          const slowDown = () => {
            if (reduceMotion) return;

            const marquee = companyScrollerTrack
              .getAnimations()
              .find((animation) => animation.animationName === "company-marquee");

            if (marquee) marquee.playbackRate = 0.18;
            else companyScroller.classList.add("is-slowed");

            window.clearTimeout(slowTimer);
            slowTimer = window.setTimeout(() => {
              if (marquee) marquee.playbackRate = 1;
              companyScroller.classList.remove("is-slowed");
            }, 1000);
          };

          companyScroller.addEventListener("wheel", slowDown, { passive: true });
        }

        function setupNavContrast() {
          if (!topNav || !("IntersectionObserver" in window)) return;

          const lightSections = [ctaStage, siteFooter].filter(Boolean);
          const activeSections = new Set();
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) activeSections.add(entry.target);
                else activeSections.delete(entry.target);
              });
              topNav.classList.toggle("is-on-light", activeSections.size > 0);
            },
            { rootMargin: "-14px 0px -86% 0px", threshold: 0 },
          );

          lightSections.forEach((section) => observer.observe(section));
        }

        function setupCtaScrollStack() {
          if (!ctaGallery) return;

          const cards = [...ctaGallery.querySelectorAll(".scroll-stack-card")];
          if (!cards.length) return;

          const clamp = (value, min, max) => Math.min(max, Math.max(min, value));
          let frame = 0;

          const update = () => {
            frame = 0;

            if (reduceMotion) return;

            const galleryTop = ctaGallery.getBoundingClientRect().top + window.scrollY;
            const stackLine = window.scrollY + window.innerHeight * 0.2;

            cards.forEach((card, index) => {
              const cardTop = galleryTop + card.offsetTop;
              const scaleProgress = clamp((stackLine - cardTop) / Math.max(1, window.innerHeight * 0.72), 0, 1);
              const targetScale = 0.9 + index * 0.03;
              const scale = 1 - scaleProgress * (1 - targetScale);

              card.style.transform = `scale(${scale.toFixed(3)})`;
              card.style.zIndex = String(index + 1);
            });
          };

          const requestUpdate = () => {
            if (frame) return;
            frame = window.requestAnimationFrame(update);
          };

          window.addEventListener("scroll", requestUpdate, { passive: true });
          updateCtaScrollStack = requestUpdate;
          update();
        }

        function measureMorph() {
          if (!morphZone || !humanPhrase) return;

          const previousWidth = morphZone.style.width;
          morphZone.style.width = "max-content";
          const intrinsicPhraseWidth = humanPhrase.getBoundingClientRect().width;
          const availablePhraseWidth = Math.max(180, window.innerWidth * 0.88);
          morphPhraseFit = Math.min(1, availablePhraseWidth / Math.max(1, intrinsicPhraseWidth));
          morphOpenWidthPx = Math.ceil(intrinsicPhraseWidth * morphPhraseFit + 4);
          morphZone.style.setProperty("--morph-open-width", `${morphOpenWidthPx}px`);
          humanPhrase.style.setProperty("--phrase-fit", morphPhraseFit.toFixed(4));
          morphZone.style.width = previousWidth;
        }

        function setMorphWidth() {
          if (!morphZone || !morphOpenWidthPx) return;

          morphZone.style.width = `${morphOpenWidthPx}px`;
        }

         function resizeCanvas() {
           if (!videoCanvas) return;

           const bounds = videoCanvas.getBoundingClientRect();
           const dpr = Math.min(window.devicePixelRatio || 1, 2);
           videoContext ??= videoCanvas.getContext("2d");
           if (!videoContext) return;

           canvasWidth = Math.max(1, bounds.width);
           canvasHeight = Math.max(1, bounds.height);
           videoCanvas.width = Math.round(canvasWidth * dpr);
           videoCanvas.height = Math.round(canvasHeight * dpr);
           videoContext.setTransform(dpr, 0, 0, dpr, 0, 0);
           drawTerminal(0);
        }

        function drawTerminal(time) {
           if (!videoCanvas || !videoContext) return;

           const context = videoContext;
           const width = canvasWidth || videoCanvas.clientWidth || 280;
           const height = canvasHeight || videoCanvas.clientHeight || 120;
           const padding = Math.max(4, Math.min(width * 0.08, height * 0.14));
           const pulse = (Math.sin(time / 430) + 1) / 2;

          context.clearRect(0, 0, width, height);
          context.fillStyle = "#0b1d82";
          context.fillRect(0, 0, width, height);

           context.strokeStyle = "rgba(251, 251, 247, .085)";
           context.lineWidth = 1;
           for (let y = 0; y < height; y += Math.max(8, height * 0.22)) {
             context.beginPath();
             context.moveTo(0, y + 0.5);
             context.lineTo(width, y + 0.5);
             context.stroke();
           }

           const headerHeight = Math.max(padding * 2.4, height * 0.3);
           const base = Math.max(4, Math.min(width / 27, (height - headerHeight - padding) / 6.1));
           context.font = `500 ${base}px "IBM Plex Mono", monospace`;
           context.textBaseline = "top";

           context.fillStyle = "#d4ff45";
           context.beginPath();
           context.arc(padding + base * 0.32, padding + base * 0.45, Math.max(2, base * 0.3), 0, Math.PI * 2);
           context.fill();
           context.fillStyle = "rgba(251, 251, 247, .78)";
           context.fillText("TERM / 01", padding + base * 1.05, padding);
           context.fillStyle = "#d4ff45";
           context.fillRect(padding + base * 1.05, padding + base * 1.42, base * 4.1, Math.max(1, base * 0.13));
           context.fillStyle = "rgba(251, 251, 247, .48)";
           context.fillRect(padding + base * 5.55, padding + base * 1.42, base * 2.25, Math.max(1, base * 0.13));
           context.fillStyle = "rgba(251, 251, 247, .22)";
           context.fillRect(0, headerHeight, width, 1);

           const lines = [
             ["$ cd ~/projects/wtfis", "#fbfbf7"],
             ["zsh: no such file or directory", "#ffb5aa"],
             ['$ find .. -type d -name "wtfis"', "#d4ff45"],
             ["/Desktop/old-projects/wtfis", "#aebfff"],
           ];

           const maxCharacters = Math.max(5, Math.floor((width - padding * 2) / Math.max(1, base * 0.62)));
           const fitLine = (line) => line.length > maxCharacters ? `${line.slice(0, Math.max(1, maxCharacters - 1))}…` : line;
           const lineHeight = Math.max(7, base * 1.5);
           const startY = headerHeight + Math.max(2, base * 0.45);

           lines.forEach(([line, color], index) => {
             const fittedLine = fitLine(line);
             context.fillStyle = color;
             context.globalAlpha = index === lines.length - 1 ? 0.72 + pulse * 0.28 : 1;
             context.fillText(fittedLine, padding, startY + index * lineHeight);
           });

           context.globalAlpha = 0.35 + pulse * 0.65;
           context.fillStyle = "#d4ff45";
           const lastLine = fitLine(lines[lines.length - 1][0]);
           context.fillRect(
             Math.min(width - padding - Math.max(2, base * 0.4), padding + context.measureText(lastLine).width + base * 0.2),
             startY + (lines.length - 1) * lineHeight,
             Math.max(2, base * 0.32),
             Math.max(5, base * 0.9),
           );
          context.globalAlpha = 1;
        }

        function markProgress(step) {
          progressSteps
            .filter((item) => item.dataset.step === step)
            .forEach((item) => item.classList.add("is-complete"));
        }

        function resetProgress() {
          progressSteps.forEach((item) => item.classList.remove("is-complete"));
