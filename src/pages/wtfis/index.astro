        function estimateManualSeconds(value, pasted) {
          if (pasted) return 12;
          if (/^(?:\.|\.\.|-)$/.test(value.trim())) return 4;
          return Math.min(90, Math.max(22, 12 + value.replace(/\s/g, "").length * 3));
        }

        function appendHistory(container, className, message) {
          if (!container) return;

          const line = document.createElement("span");
          line.className = className;
          line.textContent = message;
          container.appendChild(line);

          while (container.children.length > 5) {
            container.firstElementChild.remove();
          }

          container.scrollTop = container.scrollHeight;
        }

        function normalizeSearch(value) {
          return value.toLowerCase().replace(/[^a-z0-9]/g, "");
        }

        function editDistance(left, right) {
          const previous = Array.from({ length: right.length + 1 }, (_, index) => index);

          for (let leftIndex = 1; leftIndex <= left.length; leftIndex += 1) {
            const current = [leftIndex];
            for (let rightIndex = 1; rightIndex <= right.length; rightIndex += 1) {
              const cost = left[leftIndex - 1] === right[rightIndex - 1] ? 0 : 1;
              current[rightIndex] = Math.min(
                current[rightIndex - 1] + 1,
                previous[rightIndex] + 1,
                previous[rightIndex - 1] + cost,
              );
            }
            previous.splice(0, previous.length, ...current);
          }

          return previous[right.length];
        }

        function fuzzyProject(query) {
          const normalized = normalizeSearch(query);
          if (!normalized) return null;

          const ranked = labProjects
            .map((project) => {
              const name = normalizeSearch(project.name);
              const distance = editDistance(normalized, name);
              const contains = name.includes(normalized) || normalized.includes(name);
              return { project, distance, contains };
            })
            .sort((left, right) => Number(right.contains) - Number(left.contains) || left.distance - right.distance);
          const winner = ranked[0];
          const allowedDistance = Math.max(2, Math.round(normalizeSearch(winner.project.name).length * 0.36));

          return winner.contains || winner.distance <= allowedDistance ? winner.project : null;
        }

        function startInputDemo(input, getValue) {
          if (!input || reduceMotion) return;

          let index = 0;
          let deleting = false;

          function tick() {
            if (input.value || document.activeElement === input) {
              input.placeholder = "";
              window.setTimeout(tick, 700);
              return;
            }

            const target = getValue();
            index += deleting ? -1 : 1;
            input.placeholder = target.slice(0, Math.max(0, index));

            if (!deleting && index >= target.length) {
              deleting = true;
              window.setTimeout(tick, 1000);
              return;
            }

            if (deleting && index <= 0) {
              deleting = false;
              window.setTimeout(tick, 650);
              return;
            }

            window.setTimeout(tick, deleting ? 34 : 58);
          }

          window.setTimeout(tick, 800);
        }

        function startSectionTwoAnimation() {
          if (sectionTwoAnimationStarted || !humanPhrase || !commandShell) return;

          sectionTwoAnimationStarted = true;
          const finish = () => {
            startCommandLoop();
          };

          if (!hasGsap) {
            humanPhrase.style.opacity = "0";
            humanPhrase.style.transform = `scale(${morphPhraseFit * 0.92})`;
            commandShell.style.opacity = "1";
            commandShell.style.transform = "scaleX(1) scaleY(1) rotateX(0)";
            window.setTimeout(finish, reduceMotion ? 1 : 700);
            return;
          }

          sectionTwoTimeline = gsap.timeline({ defaults: { ease: "power2.out" } })
            .to(humanPhrase, {
              autoAlpha: 0,
              y: 8,
              scale: morphPhraseFit * 0.92,
              duration: reduceMotion ? 0.01 : 0.72,
              delay: reduceMotion ? 0 : 0.65,
            })
            .to(
              commandShell,
              {
                autoAlpha: 1,
                scaleX: 1,
                scaleY: 1,
                rotationX: 0,
                duration: reduceMotion ? 0.01 : 0.58,
                ease: "back.out(1.2)",
              },
              "-=0.14",
            )
            .call(finish);
        }

        function playScrollTo(element) {
          if (!element) return;

          autoScrollTween?.kill();
          const start = window.scrollY;
          const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
          const target = Math.max(0, Math.min(maxScroll, start + element.getBoundingClientRect().top));
          const distance = Math.abs(target - start);

          if (reduceMotion || !hasGsap || distance < 2) {
            setScrollPosition(target);
            return;
          }

          const state = { value: start };
          autoScrollTween = gsap.to(state, {
            value: target,
            duration: Math.min(1.35, Math.max(0.55, distance / 2200)),
            ease: "power2.inOut",
            overwrite: true,
            onUpdate: () => setScrollPosition(state.value),
            onComplete: () => {
              autoScrollTween = null;
            },
          });
        }

        function requestCtaDrawer() {
          playScrollTo(ctaStage);
        }

        function setupPlaygroundStage() {
          if (!playground) return;
          const observer = new IntersectionObserver(
            ([entry]) => {
              playgroundVisible = entry.isIntersecting;
              if (entry.isIntersecting) {
                coachTimeline?.play();
                setVideoState(false);
                stopCommandLoop();
              } else {
                coachTimeline?.pause();
                if (window.scrollY < playground.offsetTop) setVideoState(true);
              }
            },
            { threshold: 0.08 },
          );
          observer.observe(playground);
        }

        function startCommandLoop() {
          if (commandLoopStarted || !commandSuffix) return;

          commandLoopStarted = true;

           if (reduceMotion) {
             commandSuffix.textContent = "project";
             commandShell?.style.setProperty("--shell-width", "3.45em");
             setMorphWidth();
             return;
           }

          const suffixes = ["project", "yoursister", "--prev", "--root", "--last", "--where", "--recent", "--up"];
          let suffixIndex = 0;
          let characterIndex = 0;
          let deleting = false;

           function resizeCommand(text) {
             if (!commandShell) return;

             commandShell.style.setProperty("--shell-width", "3.45em");
             setMorphWidth();
          }

          function tick() {
            const target = suffixes[suffixIndex];

            if (!deleting) {
              characterIndex += 1;
              commandSuffix.textContent = target.slice(0, characterIndex);
              resizeCommand(commandSuffix.textContent);

              if (characterIndex >= target.length) {
                deleting = true;
                commandTimer = window.setTimeout(tick, 900);
                return;
              }

              commandTimer = window.setTimeout(tick, 78);
              return;
            }

            characterIndex -= 1;
            commandSuffix.textContent = target.slice(0, characterIndex);
            resizeCommand(commandSuffix.textContent);

            if (characterIndex <= 0) {
              deleting = false;
              suffixIndex = (suffixIndex + 1) % suffixes.length;
              commandTimer = window.setTimeout(tick, 290);
              return;
            }

            commandTimer = window.setTimeout(tick, 48);
          }

          tick();
        }

        function stopCommandLoop() {
          if (!commandLoopStarted) return;

          window.clearTimeout(commandTimer);
           commandLoopStarted = false;
           commandSuffix.textContent = "";
           commandShell?.style.setProperty("--shell-width", "3.45em");
           morphZone?.style.setProperty("width", `${morphOpenWidthPx}px`);
        }

        function refreshPointerBounds() {
          pointerBounds.clear();
          [...words, ...mediaCards, ...notifications, ...whatHoverWords].forEach((element) => {
            pointerBounds.set(element, element.getBoundingClientRect());
          });
          pointerBoundsReady = true;
        }

        function setVideoState(shouldRun) {
          videoRequested = shouldRun;
          videoRunning = shouldRun && videoVisible && !reduceMotion;

          if (!videoRunning && videoFrame) {
            window.cancelAnimationFrame(videoFrame);
            videoFrame = 0;
          }

          if (videoRunning && !videoFrame) {
            videoFrame = requestAnimationFrame(function renderTerminal(timestamp) {
              drawTerminal(timestamp);
              videoFrame = videoRunning ? requestAnimationFrame(renderTerminal) : 0;
            });
          }
        }

        function setVideoVisibility(isVisible) {
          if (videoVisible === isVisible) return;
          videoVisible = isVisible;
          setVideoState(videoRequested);
        }

        function setupVideoVisibility() {
          if (!videoCard || !("IntersectionObserver" in window)) return;

          const observer = new IntersectionObserver(([entry]) => {
            setVideoVisibility(entry.isIntersecting);
          }, { threshold: 0.05 });
          observer.observe(videoCard);
        }

        function revealWithoutGsap() {
          document
            .querySelectorAll(".menu-pill, .title-row, .media-card__surface, .notification")
            .forEach((element) => {
              element.style.opacity = "1";
            });
        }

        function runSectionTransition() {
          if (!whatSection || !scrollScene) return;

          if (!hasGsap) {
            const clamp = (value, min, max) => Math.min(max, Math.max(min, value));
            const updateWithoutGsap = () => {
              const sceneRange = Math.max(1, scrollScene.offsetHeight - window.innerHeight);
              const progress = clamp(-scrollScene.getBoundingClientRect().top / sceneRange, 0, 1);
              const curtainIn = clamp((progress - 0.04) / 0.24, 0, 1);
              const curtainOut = clamp((progress - 0.28) / 0.3, 0, 1);
              const curtainY = curtainIn < 1 ? 108 - curtainIn * 108 : curtainOut * 88;
              const heroOut = clamp((progress - 0.24) / 0.2, 0, 1);
               const titleIn = clamp((progress - 0.4) / 0.08, 0, 1);
              setVideoVisibility(progress < 0.24);

              unifiedGrid.style.transform = `translate3d(0, ${progress * -14}%, 0) scale(${1 + progress * 0.05})`;
              whiteCurtain.style.transform = `translate3d(0, ${curtainY}%, 0)`;
              heroShell.style.opacity = String(1 - heroOut);
              heroShell.style.transform = `translate3d(0, ${heroOut * -8}%, 0) scale(${1 - heroOut * 0.06})`;
              whatSection.style.visibility = progress >= 0.42 ? "visible" : "hidden";
              whatSection.style.opacity = progress >= 0.42 ? "1" : "0";
              whatTitle.style.opacity = String(titleIn);
              whatTitle.style.transform = `translate3d(0, ${(1 - titleIn) * 15}%, 0) scale(${0.97 + titleIn * 0.03})`;
              if (progress > 0.54) startSectionTwoAnimation();
            };

            window.addEventListener("scroll", updateWithoutGsap, { passive: true });
            window.addEventListener("resize", updateWithoutGsap, { passive: true });
            updateWithoutGsap();
            return;
          }

          gsap.set(whatSection, { autoAlpha: 0 });
          gsap.set(whatTitle, { autoAlpha: 0, yPercent: 15, scale: 0.97 });
          gsap.set(previousSectionShadow, { autoAlpha: 0, yPercent: 12, scale: 1.16 });
           gsap.set(humanPhrase, { autoAlpha: 1, scale: morphPhraseFit });
           gsap.set(commandShell, { autoAlpha: 0, scaleX: 0.28, scaleY: 0.72, rotationX: -7 });
           gsap.set(morphZone, { width: `${morphOpenWidthPx}px` });
          gsap.set(whiteCurtain, { yPercent: 108 });

          const sceneTimeline = gsap.timeline({
            scrollTrigger: {
              trigger: scrollScene,
              start: "top top",
              end: "bottom bottom",
              scrub: finePointer ? 0.35 : true,
                invalidateOnRefresh: true,
                onUpdate: (self) => {
                  setVideoVisibility(self.progress < 0.24);
                  if (self.progress > 0.54) startSectionTwoAnimation();
               },
            },
          });

          sceneTimeline.to(unifiedGrid, { yPercent: -14, scale: 1.05, duration: 1, ease: "none" }, 0);

          sceneTimeline
            .to(
              heroShell,
              {
                yPercent: -4,
                scale: 0.98,
                duration: 0.3,
                ease: "none",
              },
              0.02,
            )
            .to(
              heroShell,
              {
                yPercent: -8,
                scale: 0.94,
                autoAlpha: 0,
                duration: 0.2,
                ease: "none",
              },
              0.24,
            )
            .to(whiteCurtain, { yPercent: 0, duration: 0.3, ease: "power3.inOut" }, 0.08)
             .set(whatSection, { autoAlpha: 1 }, 0.38)
             .to(previousSectionShadow, { autoAlpha: 0.12, yPercent: 0, scale: 1.04, duration: 0.3, ease: "power2.out" }, 0.4)
              .to(whiteCurtain, { yPercent: 88, duration: 0.34, ease: "power3.inOut" }, 0.4)
              .set(whatTitle, { autoAlpha: 1 }, 0.4)
              .to(whatTitle, { yPercent: 0, scale: 1, duration: 0.28, ease: "power2.out" }, 0.4);
        }

        function runIntro() {
          if (!hasGsap) {
            revealWithoutGsap();
            setVideoState(true);
            return;
          }

          if (reduceMotion) {
            revealWithoutGsap();
          } else {
            const intro = gsap.timeline({ defaults: { ease: "power3.out" } });

            intro
              .addLabel("titleReveal")
              .fromTo(
                ".menu-pill",
                { y: -16, opacity: 0 },
                { y: 0, opacity: 1, duration: 0.52, stagger: 0.065 },
              )
              .fromTo(
                ".title-row",
                { y: 82, opacity: 0 },
                { y: 0, opacity: 1, duration: 0.78, stagger: 0.14, ease: "power4.out" },
                "titleReveal+=0.42",
              )
              .fromTo(
                ".media-card__surface",
                { scale: 0.72, rotation: -2.5, opacity: 0 },
                { scale: 1, rotation: 0, opacity: 1, duration: 0.64, stagger: 0.08, ease: "back.out(1.45)" },
                "titleReveal+=0.42",
              )
              .fromTo(
                ".notice--left",
                { x: "-120vw", opacity: 0, rotation: -3.5, scale: 0.94 },
                { x: 0, opacity: 1, rotation: -1.4, scale: 1, duration: 0.62, stagger: 0.08, ease: "power3.out" },
                "titleReveal+=1.28",
              )
              .fromTo(
                ".notice--right",
                { x: "120vw", opacity: 0, rotation: 3.5, scale: 0.94 },
                { x: 0, opacity: 1, rotation: 1.4, scale: 1, duration: 0.62, stagger: 0.08, ease: "power3.out" },
                "titleReveal+=1.42",
              );
          }

          setVideoState(true);
        }

        function runLoader() {
          const finish = () => {
            loadingScreen?.remove();
            runIntro();
          };

          if (!loadingScreen || reduceMotion || !hasGsap) {
            finish();
            return;
          }

          const phrases = ["Fucking Hell.", "Fuck This", "What The Fuck", "Fuck Yeah", "Fuck Loading.", "Fuck Error"];
          const progress = { value: 1 };
          let previousPhrase = "";
          try {
            previousPhrase = window.sessionStorage.getItem("wtfis-loader-phrase") || "";
          } catch {}

          const updatePhrase = () => {
            if (!loadingPhrase) return;
            const choices = phrases.filter((phrase) => phrase !== previousPhrase);
            const nextPhrase = choices[Math.floor(Math.random() * choices.length)];
            try {
              window.sessionStorage.setItem("wtfis-loader-phrase", nextPhrase);
            } catch {}
            loadingPhrase.textContent = nextPhrase;
            gsap.killTweensOf(loadingPhrase);
            gsap.fromTo(
              loadingPhrase,
              { y: 42, autoAlpha: 0, scale: 0.82, rotateX: -48, filter: "blur(6px)" },
              { y: 0, autoAlpha: 1, scale: 1, rotateX: 0, filter: "blur(0px)", duration: 0.24, ease: "back.out(1.4)" },
            );
          };

          const updateProgress = () => {
            const value = Math.min(100, Math.max(1, Math.round(progress.value)));
            if (loadingPercent) loadingPercent.textContent = `${value}%`;
            if (loadingGraphPath) loadingGraphPath.style.strokeDashoffset = String(1 - value / 100);
          };

          updatePhrase();
          updateProgress();
          gsap
            .timeline({ defaults: { ease: "power3.out" } })
            .to(progress, { value: 100, duration: 1.3, ease: "power1.inOut", onUpdate: updateProgress })
            .to(".loading-screen", { yPercent: -100, duration: 0.32, delay: 0.05, ease: "power4.inOut" })
            .call(finish);
        }

        if (ctaButton) {
          ctaButton.addEventListener("click", (event) => {
            event.preventDefault();
            requestCtaDrawer();
          });
        }

        const cancelAutoScroll = () => {
          autoScrollTween?.kill();
          autoScrollTween = null;
        };
        window.addEventListener("wheel", cancelAutoScroll, { passive: true });
        window.addEventListener("touchstart", cancelAutoScroll, { passive: true });
        window.addEventListener("keydown", (event) => {
          if (["ArrowDown", "ArrowUp", "PageDown", "PageUp", "Home", "End", " "].includes(event.key)) {
            cancelAutoScroll();
          }
        });

        terminalPanels.forEach((panel) => {
          panel.addEventListener("click", (event) => {
            if (event.target.closest?.("input, button, a, textarea, select")) return;
            const input = panel === finderTerminal && terminalMode === "cli" ? cliInput : panel.querySelector(".terminal-input");
            input?.focus({ preventScroll: true });
          });
        });

        terminalModeTabs.forEach((tab) => {
          tab.addEventListener("click", () => setTerminalMode(tab.dataset.terminalMode));
        });

        cliInput?.addEventListener("input", () => {
          cliSelectedIndex = 0;
          renderCliResults(cliInput.value);
        });
        cliInput?.addEventListener("keydown", (event) => {
          const matches = getCliMatches(cliInput.value);
          if (!matches.length) return;

          if (event.key === "ArrowDown") {
            event.preventDefault();
            cliSelectedIndex = Math.min(cliSelectedIndex + 1, matches.length - 1);
            renderCliResults(cliInput.value);
          } else if (event.key === "ArrowUp") {
            event.preventDefault();
            cliSelectedIndex = Math.max(cliSelectedIndex - 1, 0);
            renderCliResults(cliInput.value);
          } else if (event.key === "Escape") {
            event.preventDefault();
            setTerminalMode("wtfis");
          }
        });
        cliForm?.addEventListener("submit", (event) => {
          event.preventDefault();
          const typed = cliInput.value.trim();
          const match = getCliMatches(typed)[cliSelectedIndex] || fuzzyProject(typed);
          if (!match) {
            renderCliResults(typed);
            return;
          }

          previousDirectory = currentDirectory;
          currentDirectory = match.path;
          updateTerminalState();
          renderCliResults(typed, match);
          markProgress("wtfis");
          showToast(`${match.name} selected.`);
        });

        finderRegenerate?.addEventListener("click", () => generateFilesystem());
        popupRegenerate?.addEventListener("click", () => generateFilesystem({ reopen: true }));
        copyProjectPath?.addEventListener("click", async () => {
          if (!popupProject) return;
          await copyText(popupProject.path, "Path copied. Paste it after cd.");
          markProgress("copy");
          cdInput?.focus({ preventScroll: true });
        });

        document.addEventListener("pointerdown", (event) => {
          if (!projectPopup?.classList.contains("is-open")) return;
          if (projectPopup.contains(event.target) || event.target.closest?.(".file-item")) return;
          closeProjectPopup();
        });

        cdInput?.addEventListener("paste", () => {
          cdEntryWasPasted = true;
          markProgress("copy");
        });
        cdInput?.addEventListener("input", (event) => {
          if (event.inputType && event.inputType !== "insertFromPaste") cdEntryWasPasted = false;
        });
        cdForm?.addEventListener("submit", (event) => {
          event.preventDefault();
          const typed = cdInput.value.trim().replace(/^cd\s+/i, "");
          const pasted = cdEntryWasPasted;
          appendHistory(cdHistory, "history-command", terminalPrompt(currentDirectory, `cd ${typed || "…"}`));
          const target = resolveDirectory(typed);
          const match = labProjects.find((project) => project.path === target);

          if (directoryExists(target)) {
            const manualSeconds = estimateManualSeconds(typed, pasted);
            previousDirectory = currentDirectory;
            currentDirectory = target;
            cdWasteSeconds += manualSeconds;
            updateTerminalState();
            updateOutcome("manual", match, { manualSeconds, pasted });
            markProgress("cd");
          } else {
            cdWrongTurns += 1;
            cdWasteSeconds += 18;
            appendHistory(cdHistory, "history-error", `cd: no such file or directory: ${typed || "empty path"}`);
            updateOutcome("error");
          }

          cdInput.value = "";
          cdEntryWasPasted = false;
        });

        wtfisForm?.addEventListener("submit", (event) => {
          event.preventDefault();
          const command = finderCommand();
          const typed = wtfisInput.value.trim().replace(new RegExp(`^${command}\\s+`, "i"), "");
          appendHistory(wtfisHistory, "history-command", terminalPrompt(currentDirectory, `${command} ${typed || "…"}`));
          const match = fuzzyProject(typed);

          if (match) {
            const savedSeconds = Math.max(18, 300 - Math.min(282, cdWasteSeconds));
            previousDirectory = currentDirectory;
            currentDirectory = match.path;
            updateTerminalState();
            updateOutcome("saved", match, { savedSeconds });
            markProgress("wtfis");
          } else {
            appendHistory(wtfisHistory, "history-error", `${command}: no project matched “${typed || "empty"}”`);
            updateOutcome("wtfis-error");
          }

          wtfisInput.value = "";
        });

        document.querySelectorAll("[data-copy]").forEach((button) => {
          button.addEventListener("click", async () => {
            await copyText(button.dataset.copy, "Install command copied.");
            const original = button.textContent;
            button.textContent = "copied";
            window.setTimeout(() => {
              button.textContent = original;
            }, 1400);
          });
        });

        if (finePointer) {
          const clamp = (value, min, max) => Math.min(max, Math.max(min, value));

          document.querySelectorAll("a, button, .word, .media-card, .what-title-row--interactive .what-word").forEach((element) => {
            element.addEventListener("mouseenter", () => cursorMask?.classList.add("is-hovering"));
            element.addEventListener("mouseleave", () => cursorMask?.classList.remove("is-hovering"));
          });

          whatHoverWords.forEach((word) => {
            word.addEventListener("pointermove", (event) => {
              if (!pointerBoundsReady) refreshPointerBounds();
              const bounds = pointerBounds.get(word);
              if (!bounds || playgroundVisible) return;
              const x = (event.clientX - bounds.left) / bounds.width - 0.5;
              const y = (event.clientY - bounds.top) / bounds.height - 0.5;
              const rotation = clamp(x * 2.6, -1.3, 1.3);

              word.style.transform = `translate3d(${x * 9}px, ${y * 6}px, 0) rotate(${rotation}deg)`;
            });

            word.addEventListener("pointerleave", () => {
              word.style.transform = "";
            });
          });

          let pointerFrame = 0;
          let pendingPointer = null;

          window.addEventListener("pointermove", (event) => {
            if (event.pointerType === "touch") return;

            pendingPointer = event;
            if (pointerFrame) return;

            pointerFrame = window.requestAnimationFrame(() => {
              pointerFrame = 0;
              const frameEvent = pendingPointer;
              if (!frameEvent) return;

            document.body.classList.add("pointer-live");
            if (cursorMask) {
               cursorMask.style.left = `${frameEvent.clientX}px`;
               cursorMask.style.top = `${frameEvent.clientY}px`;
               cursorMask.style.opacity = "1";
             }

            if (playgroundVisible) return;
            if (!pointerBoundsReady) refreshPointerBounds();

            words.forEach((word) => {
              const bounds = pointerBounds.get(word);
              if (!bounds) return;
              const centerX = bounds.left + bounds.width / 2;
              const centerY = bounds.top + bounds.height / 2;
              const distance = Math.hypot(frameEvent.clientX - centerX, frameEvent.clientY - centerY);
              const influence = Math.max(0, 1 - distance / 230);
              const rotation = clamp((frameEvent.clientX - centerX) * influence * 0.012, -1.4, 1.4);
              const x = (frameEvent.clientX - centerX) * influence * 0.08;
              const y = (frameEvent.clientY - centerY) * influence * 0.065;

              word.style.transform = `translate3d(${x}px, ${y}px, 0) rotate(${rotation}deg)`;
            });

            mediaCards.forEach((card) => {
              const bounds = pointerBounds.get(card);
              if (!bounds) return;
              const centerX = bounds.left + bounds.width / 2;
              const centerY = bounds.top + bounds.height / 2;
              const rotateY = clamp(((frameEvent.clientX - centerX) / Math.max(bounds.width, 1)) * 2.5, -2.5, 2.5);
              const rotateX = clamp(((frameEvent.clientY - centerY) / Math.max(bounds.height, 1)) * -2.5, -2.5, 2.5);

              card.style.transform = `translate3d(0, 0, 0) perspective(900px) rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
            });

            notifications.forEach((notification) => {
              const bounds = pointerBounds.get(notification);
              if (!bounds) return;
              const centerX = bounds.left + bounds.width / 2;
              const distance = Math.abs(frameEvent.clientX - centerX);
              const influence = Math.max(0, 1 - distance / 460);
              const restingRotation = notification.classList.contains("notice--left") ? -1.4 : 1.4;
              const rotation = restingRotation + clamp(((frameEvent.clientX - centerX) / Math.max(bounds.width, 1)) * influence * 2.1, -2.1, 2.1);

             notification.style.transform = `rotate(${rotation}deg)`;
            });
          });
          });

          window.addEventListener("pointerleave", () => {
            document.body.classList.remove("pointer-live");
            cursorMask?.classList.remove("is-hovering");
            words.forEach((word) => {
              word.style.transform = "";
            });
            whatHoverWords.forEach((word) => {
              word.style.transform = "";
            });
            mediaCards.forEach((card) => {
              card.style.transform = "";
            });
            notifications.forEach((notification) => {
              const restingRotation = notification.classList.contains("notice--left") ? -1.4 : 1.4;
              notification.style.transform = `rotate(${restingRotation}deg)`;
            });
          });
        }

        if (!finePointer) {
          [...words, ...whatHoverWords].forEach((word) => {
            word.addEventListener("pointerup", () => {
              word.classList.remove("is-tapped");
              void word.offsetWidth;
              word.classList.add("is-tapped");
              window.setTimeout(() => word.classList.remove("is-tapped"), 520);
            });
          });
        }

        const nextLink = document.querySelector('a[href="#what-is"]');

        if (nextLink) {
          nextLink.addEventListener("click", (event) => {
            event.preventDefault();
            const target = scrollScene.offsetTop + scrollScene.offsetHeight * 0.58;

            if (lenis) lenis.scrollTo(target, { duration: reduceMotion ? 0 : 0.9 });
            else window.scrollTo({ top: target, behavior: reduceMotion ? "auto" : "smooth" });
          });
        }

        setupLenis();
        setupCompanyScroller();
        setupNavContrast();
        setupCtaScrollStack();
        generateFilesystem({ silent: true });
        startInputDemo(cdInput, () => generatedProject?.path ?? `${projectRoot}/YourProject`);
        startInputDemo(wtfisInput, () => generatedProject?.name ?? "YourProject");
        setupPlaygroundStage();
        setupVideoVisibility();

        let resizeFrame = 0;
        window.addEventListener("resize", () => {
          if (resizeFrame) return;
          resizeFrame = window.requestAnimationFrame(() => {
            resizeFrame = 0;
            measureMorph();
            resizeCanvas();
            pointerBoundsReady = false;
            refreshPointerBounds();
            if (coachTimeline) positionCoach();
            updateCtaScrollStack?.();
            if (hasGsap) ScrollTrigger.refresh();
            else window.dispatchEvent(new Event("scroll"));
          });
        }, { passive: true });
         measureMorph();
         resizeCanvas();
          runSectionTransition();
          refreshPointerBounds();
          runLoader();

         if (hasGsap) {
           ScrollTrigger.refresh();
         }

         // Re-measure after the remote display fonts settle so the morph and scrub ranges stay aligned.
          document.fonts?.ready?.then(() => {
            measureMorph();
            pointerBoundsReady = false;
            refreshPointerBounds();
            if (hasGsap) ScrollTrigger.refresh();
          });
       })();
    </script>
  </body>
</html>
