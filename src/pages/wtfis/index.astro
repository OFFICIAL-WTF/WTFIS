        function generateFilesystem({ reopen = false, silent = false } = {}) {
          const used = new Set();
          labProjects = Array.from({ length: 14 }, (_, index) => {
            const name = randomProjectName(used);
            return {
              id: `${Date.now()}-${index}`,
              name,
                path: `${projectRoot}/${name}`,
              generated: index === 0,
            };
          });
          generatedProject = labProjects[0];
          popupProject = generatedProject;
          currentDirectory = projectRoot;
          previousDirectory = currentDirectory;
          cdWasteSeconds = 0;
          cdWrongTurns = 0;
          cdEntryWasPasted = false;
          resetProgress();
          closeProjectPopup();
          cdInput.value = "";
          wtfisInput.value = "";
          if (cliInput) cliInput.value = "";
          cdHistory?.replaceChildren();
          wtfisHistory?.replaceChildren();
          updateTerminalState();
          updateOutcome("default");
          renderFilesystem();
