          const requestedY = event?.clientY ?? itemBounds.bottom;
          const popupWidth = Math.min(320, panelBounds.width - 24);
          const left = Math.max(12, Math.min(requestedX - panelBounds.left + 10, panelBounds.width - popupWidth - 12));
          const top = Math.max(58, Math.min(requestedY - panelBounds.top + 8, panelBounds.height - 215));

          projectPopup.style.left = `${left}px`;
          projectPopup.style.top = `${top}px`;
          projectPopup.classList.add("is-open");
          markProgress("inspect");
          dismissCoach();
